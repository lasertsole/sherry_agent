## Chat model, must support JSON generation and tool calling
## 对话模型，必须支持 生成json功能 和 工具调用功能
MAIN_LLM_PROVIDER =
MAIN_LLM_NAME =
MAIN_LLM_API_BASE =
MAIN_LLM_API_KEY =
MAIN_LLM_MAX_TOKEN =

## Enable DeepSeek thinking mode on deepseek-chat (V3.2+). OFF by default.
## Set true to opt in; chain-of-thought will be streamed as "reasoning" chunks.
## 是否开启 deepseek-chat 思考模式（V3.2+），默认关闭；设为 true 开启，思考过程会流式返回。
MAIN_LLM_ENABLE_THINKING = false

## SkillSpector security scanner — LLM semantic analysis.
## 技能安全扫描器 —— LLM 语义分析。
## SKILL_SCANNER_ENABLED: master switch (default 1). Disable to skip scanning.
## SKILL_SCANNER_LLM: enable AI-based semantic analysis of uploaded skills.
##   NOTE: SkillSpector hardwires LangChain `with_structured_output` resolving to
##   `response_format = {"type":"json_schema","strict":true}`, which DeepSeek
##   rejects. With the default DeepSeek MAIN_LLM_* it silently degrades to a
##   static-only scan (static YARA/rules still run). Set 0 for static-only with
##   no wasted API round-trip, or point SKILLSPECTOR_PROVIDER/OPENAI_* at a
##   provider that supports `json_schema` structured output (e.g. OpenAI).
# SKILL_SCANNER_ENABLED = 1
# SKILL_SCANNER_LLM = 1
# SKILLSPECTOR_PROVIDER = openai
# SKILLSPECTOR_MODEL = deepseek-chat
# OPENAI_BASE_URL =
# OPENAI_API_KEY =

