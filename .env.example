## Chat model, must support JSON generation and tool calling
MAIN_LLM_PROVIDER =
MAIN_LLM_NAME =
MAIN_LLM_API_BASE =
MAIN_LLM_API_KEY =
MAIN_LLM_MAX_TOKEN =

## Universal reasoning/thinking switch. OFF by default. Maps to the correct
## payload per MAIN_LLM_PROVIDER when enabled:
##   deepseek                         -> extra_body thinking (V3.2+ chat API)
##   openai + compatible gateways     -> reasoning_effort (o-series / gpt-5 only)
##   openai/zhipu + GLM (glm-4.5+)    -> extra_body thinking (bigmodel v4 API)
##   anthropic                        -> thinking + budget_tokens (claude-3-7/4/opus/sonnet only)
##   all other providers / non-reasoning models -> no-op (never a 400 crash)
## Chain-of-thought is streamed as "reasoning" chunks when supported.
MAIN_LLM_ENABLE_THINKING = false
## Optional: reasoning effort for OpenAI-family models (low / medium / high; default high).
## Only applies to o-series / gpt-5 reasoning models when MAIN_LLM_ENABLE_THINKING=true.
MAIN_LLM_REASONING_EFFORT =

## SkillSpector security scanner — LLM semantic analysis.
## SKILL_SCANNER_ENABLED: master switch (default 1). Disable to skip scanning.
## SKILL_SCANNER_LLM: opt-in AI-based semantic analysis of uploaded skills.
##   OFF by default; set 1 to enable. Requires a provider that supports
##   `json_schema` strict structured output — common Chinese OpenAI-compatible
##   endpoints (DeepSeek, Zhipu GLM bigmodel.cn) accept the request but stall
##   indefinitely, so the flag stays off unless your provider qualifies.
##   The LLM used is the app's own AUXILIARY_LLM (AUXILIARY_LLM_PROVIDER /
##   AUXILIARY_LLM_API_NAME / AUXILIARY_LLM_API_BASE / AUXILIARY_LLM_API_KEY)
##   — no separate config needed here.
## SKILL_SCANNER_TIMEOUT: seconds the SkillSpector CLI subprocess may run
##   before it is killed (default 120). Bounds a stalled LLM attempt when
##   SKILL_SCANNER_LLM is on.
# SKILL_SCANNER_ENABLED = 1
# SKILL_SCANNER_LLM = 0
# SKILL_SCANNER_TIMEOUT = 120
# SKILLSPECTOR_PROVIDER = openai
# SKILLSPECTOR_MODEL =

## Reasoner model
REASONER_LLM_PROVIDER =
REASONER_LLM_NAME =
REASONER_LLM_API_BASE =
REASONER_LLM_API_KEY =
REASONER_LLM_MAX_TOKEN =

