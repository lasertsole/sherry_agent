## Speech-to-Text model
STT_MODEL_PROVIDER =
STT_API_NAME =
STT_API_BASE =
STT_API_KEY =

# Timeout for a single tool call, in minutes. Prevents deadlock.
TOOL_CALL_TIMEOUT_MINUTES = 5

# Log level for console output and info log files: TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
LOG_LEVEL = INFO

# Required for web search functionality
# 联网搜索功能必填
TAVILY_API_KEY =

# subagent
SUBAGENT_TODO_DONE_FUNC = "archive"

# Default workspace template language (lazy-copied persona files from workspace/template/{lang}/)
# Default template language when user preference is unknown: en / zh / ja / ko
WORKSPACE_TEMPLATE_LANG = en

## LangSmith
LANGSMITH_TRACING_V2 = false
LANGSMITH_API_KEY =
LANGSMITH_PROJECT = "EMA_AI_agent"

## Sandbox policy for terminal / python_repl: required / auto / off
# required: the OS sandbox (bwrap on Linux, sandbox-exec on macOS) must be available,
#           otherwise commands are rejected
# auto: use the sandbox when available, otherwise run unsandboxed with a warning (default)
# off: disable sandboxing entirely
SANDBOX_POLICY = auto