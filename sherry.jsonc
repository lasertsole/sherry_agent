// App-level runtime config (split out of the .env environment config). JSON5 format: comments and trailing commas allowed.
// Takes effect after a backend restart (editable in the client via System Config → App Config).
{
  // Stored setting only — no tool-execution path consumes it. Real per-tool timeouts come from
  // the TOOLS_TIMEOUTS registry (WEB_SEARCH_TIMEOUT=15 / TERMINAL_TIMEOUT=30 /
  // PYTHON_REPL_TIMEOUT=30): config/features/agent_side/tools_timeouts.py
  "TOOL_CALL_TIMEOUT_MINUTES": 5,

  // Default cumulative-token cap for a conversation that never set its own.
  // 0 = unlimited (the default). A session's own cap always wins; clear it in
  // the session's Token 预算 tab to go back to this value's behaviour.
  "TOKEN_BUDGET_DEFAULT_CAP": 0,

  // Log level for console output and info log files: TRACE / DEBUG / INFO / SUCCESS / WARNING / ERROR / CRITICAL
  "LOG_LEVEL": "INFO",


  // Process-level default project directory — where the agent works when a
  // session has no explicit binding. Empty = the repository root (the historical
  // behaviour). SHERRY_PROJECT_DIR overrides this key for a single launch.
  "project_dir": "",

  // Replay-gate allowlist extension: executable names (lowercase) the finish-time
  // regression gate may re-run ON TOP OF the built-in five toolchains (Python /
  // JS-TS / Rust / Go / C-C++). Add a new one here (gradle / maven / dotnet /
  // rspec / swift / …) instead of editing code. Only the replay gate reads it —
  // which commands a subagent may RECORD is unaffected. Entries are validated
  // (no shell metacharacters); keep the array on one line.
  "regression_gate_allowed_executables": [],


  // Default workspace template language (lazy-copied persona files from workspace/template/{lang}/): en / zh / ja / ko
  "WORKSPACE_TEMPLATE_LANG": "en",

  // Global heartbeat scheduler switch (the Heartbeat panel toggle writes this value and applies it live).
  // Off by default: the periodic heartbeat is opt-in. false = it never fires; delivery to channels
  // is separately gated per channel.
  "heartbeat": {
    "enabled": false
  },

  // LangSmith tracing lives in .network now (LANGSMITH_* keys): it is network-service
  // config, and .network is gitignored (this file is tracked and must not hold keys).

  // Curator — background skill maintenance orchestrator for agent-created skills.
  "curator": {
    // Whether Curator is enabled
    "enabled": true,

    // Minimum interval between curator runs (hours); 7 days
    "interval_hours": 168,

    // Agent must be idle for at least N hours before curator triggers
    "min_idle_hours": 2,

    // Days of inactivity before a skill is marked stale
    "stale_after_days": 30,

    // Days of inactivity before a skill is archived
    "archive_after_days": 90,

    // Whether to enable LLM consolidation pass (merge narrow skills into umbrellas)
    "consolidate": true,

    // Whether to clean up usage records for built-in skills
    "prune_builtins": true
  },

  // User-configurable lifecycle hooks (Step 1: read-only dispatch).
  // Each entry is a command (split with shlex, NO shell) that receives one JSON
  // payload on stdin and may print an optional JSON outcome on stdout; a
  // non-JSON stdout is a successful run. Events dispatched today:
  // PostToolUse / PostToolUseFailure (toolName, toolCallId, result/error preview,
  // durationMs) and Stop (responsePreview, toolCallCount). PreToolUse /
  // UserPromptSubmit / SessionStart are accepted by the parser but NOT
  // dispatched in this build (blocking hooks need a trust gate).
  // OFF by default: hooks execute commands, so enabling them is a deliberate act.
  "hooks": {
    // Master switch
    "enabled": false

    // Example entries (uncomment to use):
    // ,"PostToolUse": [
    //   { "command": "python ~/.sherry/hooks/audit_tool.py", "matcher": "write_*|patch_file", "timeout_ms": 5000 }
    // ],
    // ,"Stop": [
    //   { "command": "curl -s -X POST http://localhost:9999/turn-done --data-binary @-", "matcher": "*", "timeout_ms": 3000 }
    // ]
  }
}
