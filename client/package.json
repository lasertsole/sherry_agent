{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:watch": "vitest",
    "dpdm": "dpdm 'app/**/*.{ts,mjs}' --circular --exit-code circular:1 --no-progress"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@antv/g6": "^5.1.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@primevue/themes": "^4.5.0",
    "@tauri-apps/api": "^2.11.1",
    "@types/lodash-es": "^4.17.12",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.13",
    "lodash-es": "^4.18.1",
    "markdown-it": "^15.0.2",
    "mitt": "^3.0.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^8.0.1",
    "primevue": "^4.5.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-angular": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/testing": "^2.0.1",
    "@playwright/test": "^1.63.0",
    "@primevue/nuxt-module": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "dpdm": "^4.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.0",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "sass": "^1.104.1",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.70.0",
    "unimport": "^7.0.2",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
