{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:watch": "vitest",
    "dpdm": "dpdm 'app/**/*.{ts,mjs}' --circular --exit-code circular:1 --no-progress",
    "build:desktop": "nuxt generate"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@antv/g6": "^5.1.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@primevue/themes": "^4.5.4",
    "@tanstack/vue-virtual": "^3.13.40",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@types/lodash-es": "^4.17.12",
    "cropperjs": "^1.6.3",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "dompurify": "^3.4.16",
    "lodash-es": "^4.18.1",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.2",
    "mitt": "^3.0.1",
    "nuxt": "^4.5.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^8.0.2",
    "primevue": "^4.5.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-angular": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@primevue/nuxt-module": "^5.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "dpdm": "^4.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.0",
    "unimport": "^7.0.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
