{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "vue-tsc --noEmit -p .nuxt/tsconfig.app.json",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run integration.test.ts",
    "test:watch": "vitest",
    "test:e2e:packaged": "node e2e/packaged/run.mjs",
    "test:e2e:packaged:spike": "node e2e/packaged/run.mjs --spike",
    "test:e2e:packaged:list": "node e2e/packaged/run.mjs --list",
    "test:e2e:packaged:mock": "python3 e2e/packaged/mock_llm.py --selftest",
    "dpdm": "dpdm 'app/**/*.{ts,mjs}' --circular --exit-code circular:1 --no-progress",
    "build:desktop": "nuxt generate"
  },
  "dependencies": {
    "@antv/g2": "^5.4.8",
    "@antv/g6": "^5.1.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@primevue/themes": "^4.5.4",
    "@tanstack/vue-virtual": "^3.13.40",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@types/lodash-es": "^4.17.12",
    "@vscode/markdown-it-katex": "^1.1.2",
    "cropperjs": "^1.6.3",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "katex": "^0.18.11",
    "lodash-es": "^4.18.1",
    "mammoth": "^1.13.0",
    "markdown-it": "^15.0.3",
    "mermaid": "^12.2.0",
    "mitt": "^3.0.1",
    "nuxt": "^4.6.4",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^8.0.2",
    "primevue": "^4.5.5",
    "shiki": "^4.5.0",
    "vue": "^3.5.44",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-angular": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^9.0.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.65.1",
    "@primevue/nuxt-module": "^5.0.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "dpdm": "^4.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsdoc": "^65.5.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31.0.1",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "selenium-webdriver": "^4.53.0",
    "tailwindcss": "^4.3.5",
    "typescript-eslint": "^8.73.0",
    "unimport": "^7.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
