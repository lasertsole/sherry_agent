+
+/// Converts a list of single-character string ranges into `char` ranges.
+fn char_ranges(ranges: &[(String, String)]) -> Vec<(char, char)> {
+    ranges
+        .iter()
+        .map(|(start, end)| {
+            (
+                start.chars().next().expect("empty char literal"),
+                end.chars().next().expect("empty char literal"),
+            )
+        })
+        .collect()
+}
