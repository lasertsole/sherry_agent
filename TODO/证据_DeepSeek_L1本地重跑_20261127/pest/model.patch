+    /// Attempts to match a single character from any of the given inclusive ranges. Returns `Ok`
+    /// with the updated `Box<ParserState>` if successful, or `Err` with the updated
+    /// `Box<ParserState>` otherwise.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// # use pest;
+    /// # #[allow(non_camel_case_types)]
+    /// # #[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+    /// enum Rule {}
+    ///
+    /// let input = "b";
+    /// let mut state: Box<pest::ParserState<'_, Rule>> = pest::ParserState::new(input);
+    /// let result = state.match_char_class(&[('a', 'z'), ('A', 'Z')]);
+    /// assert!(result.is_ok());
+    /// assert_eq!(result.unwrap().position().pos(), 1);
+    ///
+    /// let input = "1";
+    /// let mut state: Box<pest::ParserState<'_, Rule>> = pest::ParserState::new(input);
+    /// let result = state.match_char_class(&[('a', 'z'), ('A', 'Z')]);
+    /// assert!(result.is_err());
+    /// assert_eq!(result.unwrap_err().position().pos(), 0);
+    /// ```
+    #[inline]
+    pub fn match_char_class(mut self: Box<Self>, ranges: &[(char, char)]) -> ParseResult<Box<Self>> {
+        let start_position = self.position.pos();
+        let succeeded = self
+            .position
+            .match_char_by(|c| ranges.iter().any(|&(start, end)| c >= start && c <= end));
+        if self.parse_attempts.enabled {
+            let token = ParsingToken::CharClass {
+                ranges: ranges.to_vec(),
+            };
+            self.handle_token_parse_result(start_position, token, succeeded);
+        }
+        if succeeded {
+            Ok(self)
+        } else {
+            Err(self)
+        }
+    }
+
+    /// Attempts to match a single character that is not in any of the given inclusive ranges.
+    /// Returns `Ok` with the updated `Box<ParserState>` if successful, or `Err` with the updated
+    /// `Box<ParserState>` otherwise.
+    ///
+    /// # Examples
+    ///
+    /// ```
+    /// # use pest;
+    /// # #[allow(non_camel_case_types)]
+    /// # #[derive(Clone, Copy, Debug, Eq, Hash, Ord, PartialEq, PartialOrd)]
+    /// enum Rule {}
+    ///
+    /// let input = "1";
+    /// let mut state: Box<pest::ParserState<'_, Rule>> = pest::ParserState::new(input);
+    /// let result = state.match_neg_char_class(&[('a', 'z'), ('A', 'Z')]);
+    /// assert!(result.is_ok());
+    /// assert_eq!(result.unwrap().position().pos(), 1);
+    ///
+    /// let input = "b";
+    /// let mut state: Box<pest::ParserState<'_, Rule>> = pest::ParserState::new(input);
+    /// let result = state.match_neg_char_class(&[('a', 'z'), ('A', 'Z')]);
+    /// assert!(result.is_err());
+    /// assert_eq!(result.unwrap_err().position().pos(), 0);
+    /// ```
+    #[inline]
+    pub fn match_neg_char_class(
+        mut self: Box<Self>,
+        ranges: &[(char, char)],
+    ) -> ParseResult<Box<Self>> {
+        let start_position = self.position.pos();
+        let succeeded = self
+            .position
+            .match_char_by(|c| !ranges.iter().any(|&(start, end)| c >= start && c <= end));
+        if self.parse_attempts.enabled {
+            let token = ParsingToken::NegCharClass {
+                ranges: ranges.to_vec(),
+            };
+            self.handle_token_parse_result(start_position, token, succeeded);
+        }
+        if succeeded {
+            Ok(self)
+        } else {
+            Err(self)
+        }
+    }
+
