+/// Builds a list of `(char, char)` inclusive ranges out of a list of
+/// single-character string ranges.
+fn char_class_ranges(ranges: &[(String, String)]) -> Vec<TokenStream> {
+    ranges
+        .iter()
+        .map(|(start, end)| {
+            let start = start.chars().next().expect("empty char literal");
+            let end = end.chars().next().expect("empty char literal");
+
+            quote! { (#start, #end) }
+        })
+        .collect()
+}
