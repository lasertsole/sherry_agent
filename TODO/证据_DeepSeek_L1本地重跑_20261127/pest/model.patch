+
+//! Coalesces choices of single-character expressions into character classes.
+//!
+//! A choice such as `"a" | "b" | "c" | "d"` is turned into a single
+//! `CharClass` expression matching one character in any of the merged ranges.
+//! Similarly, `!("a" | "b") ~ ANY` is turned into a `NegCharClass`.
+
+use crate::optimizer::*;
+
+/// Coalesces single-character choices into character classes.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    let expr = expr.map_top_down(coalesce_expr);
+    OptimizedRule { name, ty, expr }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(..) => coalesce_choice(expr),
+        OptimizedExpr::Seq(lhs, rhs) => coalesce_seq(*lhs, *rhs),
+        expr => expr,
+    }
+}
+
+/// Flattens a (right-nested) `Choice` chain into its ordered alternatives.
+fn flatten_choice(expr: OptimizedExpr) -> Vec<OptimizedExpr> {
+    let mut alternatives = Vec::new();
+    let mut current = expr;
+
+    loop {
+        match current {
+            OptimizedExpr::Choice(lhs, rhs) => {
+                alternatives.push(*lhs);
+                current = *rhs;
+            }
+            expr => {
+                alternatives.push(expr);
+                break;
+            }
+        }
+    }
+
+    alternatives
+}
+
+/// Rebuilds a right-nested `Choice` chain from the given alternatives.
+fn build_choice(mut alternatives: Vec<OptimizedExpr>) -> OptimizedExpr {
+    debug_assert!(!alternatives.is_empty());
+
+    let mut expr = alternatives.pop().expect("empty alternatives");
+    while let Some(lhs) = alternatives.pop() {
+        expr = OptimizedExpr::Choice(Box::new(lhs), Box::new(expr));
+    }
+    expr
+}
+
+/// Returns the ranges matched by a qualifying alternative, or `None` if the
+/// alternative does not qualify for coalescing.
+fn qualifying_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    match expr {
+        OptimizedExpr::Str(string) => {
+            let mut chars = string.chars();
+            match (chars.next(), chars.next()) {
+                (Some(c), None) => Some(vec![(c.to_string(), c.to_string())]),
+                _ => None,
+            }
+        }
+        OptimizedExpr::Insens(string) => {
+            let mut chars = string.chars();
+            match (chars.next(), chars.next()) {
+                (Some(c), None) => {
+                    if c.is_alphabetic() {
+                        let mut lower = c.to_lowercase();
+                        let mut upper = c.to_uppercase();
+                        match (lower.next(), lower.next(), upper.next(), upper.next()) {
+                            (Some(l), None, Some(u), None) => {
+                                Some(vec![(l.to_string(), l.to_string()), (u.to_string(), u.to_string())])
+                            }
+                            _ => Some(vec![(c.to_string(), c.to_string())]),
+                        }
+                    } else {
+                        Some(vec![(c.to_string(), c.to_string())])
+                    }
+                }
+                _ => None,
+            }
+        }
+        OptimizedExpr::Range(start, end) => Some(vec![(start.clone(), end.clone())]),
+        OptimizedExpr::CharClass(ranges) => Some(ranges.clone()),
+        OptimizedExpr::RestoreOnErr(inner) => qualifying_ranges(inner),
+        _ => None,
+    }
+}
+
+/// Merges the given ranges: sorts them ascending by start code point and merges
+/// overlapping as well as adjacent ranges.
+fn merge_ranges(mut ranges: Vec<(String, String)>) -> Vec<(String, String)> {
+    let mut chars: Vec<(char, char)> = ranges
+        .drain(..)
+        .filter_map(|(start, end)| {
+            let start = start.chars().next()?;
+            let end = end.chars().next()?;
+            Some((start, end))
+        })
+        .collect();
+
+    chars.sort_unstable_by_key(|&(start, _)| start);
+
+    let mut merged: Vec<(char, char)> = Vec::with_capacity(chars.len());
+    for (start, end) in chars {
+        match merged.last_mut() {
+            Some((_, last_end)) if start as u32 <= *last_end as u32 + 1 => {
+                if end > *last_end {
+                    *last_end = end;
+                }
+            }
+            _ => merged.push((start, end)),
+        }
+    }
+
+    merged
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+/// Turns a merged range list into a single expression.
+fn emit_ranges(ranges: Vec<(String, String)>) -> OptimizedExpr {
+    if ranges.len() == 1 {
+        let (start, end) = ranges.into_iter().next().expect("empty ranges");
+        if start == end {
+            OptimizedExpr::Str(start)
+        } else {
+            OptimizedExpr::Range(start, end)
+        }
+    } else {
+        OptimizedExpr::CharClass(ranges)
+    }
+}
+
+/// Coalesces a contiguous run of qualifying alternatives into one expression,
+/// if that actually reduces the number of ranges.
+fn coalesce_run(run: &[OptimizedExpr]) -> Option<OptimizedExpr> {
+    let mut ranges = Vec::new();
+    for alternative in run {
+        ranges.extend(qualifying_ranges(alternative)?);
+    }
+
+    let merged = merge_ranges(ranges);
+    if merged.len() < run.len() {
+        Some(emit_ranges(merged))
+    } else {
+        None
+    }
+}
+
+fn coalesce_choice(expr: OptimizedExpr) -> OptimizedExpr {
+    let alternatives = flatten_choice(expr);
+
+    if alternatives.len() < 2 {
+        return build_choice(alternatives);
+    }
+
+    // Fast path: every alternative qualifies.
+    if alternatives.iter().all(|a| qualifying_ranges(a).is_some()) {
+        if let Some(coalesced) = coalesce_run(&alternatives) {
+            return coalesced;
+        }
+        return build_choice(alternatives);
+    }
+
+    // Slow path: only coalesce contiguous runs of at least 3 qualifying
+    // alternatives.
+    let mut result: Vec<OptimizedExpr> = Vec::with_capacity(alternatives.len());
+    let mut index = 0;
+
+    while index < alternatives.len() {
+        if qualifying_ranges(&alternatives[index]).is_none() {
+            result.push(alternatives[index].clone());
+            index += 1;
+            continue;
+        }
+
+        let mut end = index;
+        while end < alternatives.len() && qualifying_ranges(&alternatives[end]).is_some() {
+            end += 1;
+        }
+
+        let run = &alternatives[index..end];
+        if run.len() >= 3 {
+            match coalesce_run(run) {
+                Some(coalesced) => result.push(coalesced),
+                None => result.extend(run.iter().cloned()),
+            }
+        } else {
+            result.extend(run.iter().cloned());
+        }
+
+        index = end;
+    }
+
+    build_choice(result)
+}
+
+/// Collapses `!inner ~ ANY` into a `NegCharClass` when all of `inner`'s
+/// alternatives qualify.
+fn coalesce_seq(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    if let (OptimizedExpr::NegPred(inner), OptimizedExpr::Ident(ident)) = (&lhs, &rhs) {
+        if ident == "ANY" {
+            if let Some(ranges) = negated_ranges(inner) {
+                return OptimizedExpr::NegCharClass(ranges);
+            }
+        }
+    }
+
+    OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs))
+}
+
+/// Returns the merged ranges excluded by a negated expression, if all of its
+/// alternatives qualify.
+fn negated_ranges(inner: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    let alternatives = flatten_choice(inner.clone());
+
+    let mut ranges = Vec::new();
+    for alternative in &alternatives {
+        ranges.extend(qualifying_ranges(alternative)?);
+    }
+
+    Some(merge_ranges(ranges))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::optimizer::OptimizedExpr::*;
+
+    fn rule(expr: OptimizedExpr) -> OptimizedRule {
+        OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Normal,
+            expr,
+        }
+    }
+
+    fn ranges(pairs: &[(&str, &str)]) -> Vec<(String, String)> {
+        pairs
+            .iter()
+            .map(|(s, e)| (s.to_string(), e.to_string()))
+            .collect()
+    }
+
+    #[test]
+    fn coalesces_all_alternatives() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(
+                Str("b".to_owned()),
+                Choice(Str("c".to_owned()), Str("d".to_owned()))
+            )
+        ));
+
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            CharClass(ranges(&[("a", "d")]))
+        );
+    }
+
+    #[test]
+    fn coalesces_into_single_range() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(Str("b".to_owned()), Str("c".to_owned()))
+        ));
+
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            Range("a".to_owned(), "c".to_owned())
+        );
+    }
+
+    #[test]
+    fn keeps_choice_when_no_reduction() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(Str("c".to_owned()), Str("e".to_owned()))
+        ));
+
+        assert_eq!(coalesce(rule(expr.clone())).expr, expr);
+    }
+
+    #[test]
+    fn coalesces_insensitive() {
+        let expr = box_tree!(Choice(
+            Insens("a".to_owned()),
+            Choice(Insens("b".to_owned()), Insens("c".to_owned()))
+        ));
+
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            CharClass(ranges(&[("A", "C"), ("a", "c")]))
+        );
+    }
+
+    #[test]
+    fn coalesces_partial_run() {
+        let expr = box_tree!(Choice(
+            Ident("x".to_owned()),
+            Choice(
+                Str("a".to_owned()),
+                Choice(
+                    Str("b".to_owned()),
+                    Choice(Str("c".to_owned()), Ident("y".to_owned()))
+                )
+            )
+        ));
+
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            box_tree!(Choice(
+                Ident("x".to_owned()),
+                Choice(Range("a".to_owned(), "c".to_owned()), Ident("y".to_owned()))
+            ))
+        );
+    }
+
+    #[test]
+    fn coalesces_negated() {
+        let expr = box_tree!(Seq(
+            NegPred(Box::new(box_tree!(Choice(
+                Str("a".to_owned()),
+                Choice(Str("b".to_owned()), Str("c".to_owned()))
+            )))),
+            Ident("ANY".to_owned())
+        ));
+
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            NegCharClass(ranges(&[("a", "c")]))
+        );
+    }
+
+    #[test]
+    fn strips_restore_on_err() {
+        let expr = box_tree!(Choice(
+            RestoreOnErr(Str("a".to_owned())),
+            Choice(Str("b".to_owned()), Str("c".to_owned()))
+        ));
+
+        assert_eq!(
+            coalesce(rule(expr)).expr,
+            Range("a".to_owned(), "c".to_owned())
+        );
+    }
+}
