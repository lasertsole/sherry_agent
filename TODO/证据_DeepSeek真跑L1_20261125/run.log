thon\nfrom __future__ import annotations\n\nfrom collections.abc import Callable\nfrom typing import TYPE_CHECKING, TypeVar\n\nfrom returns.interfaces.specific.validated import ValidatedLikeN\nfrom returns.primitives.hkt import Kinded, KindN, kinded\n\nif TYPE_CHECKING:\n    from returns.validated import Validated  # noqa: WPS433\n\n_FirstType = TypeVar(\'_FirstType\')\n_SecondType = TypeVar(\'_SecondType\')\n_ThirdType = TypeVar(\'_ThirdType\')\n_UpdatedType = TypeVar(\'_UpdatedType\')\n\n_ValidatedLikeKind = TypeVar(\'_ValidatedLikeKind\', bound=ValidatedLikeN)\n\n\ndef bind_validated(\n    function: Callable[\n        [_FirstType],\n        KindN[\'Validated\', _UpdatedType, _SecondType, _ThirdType],\n    ],\n) -> Kinded[Callable[\n    [KindN[_ValidatedLikeKind, _FirstType, _SecondType, _ThirdType]],\n    KindN[_ValidatedLikeKind, _UpdatedType, _SecondType, _ThirdType],\n]]:\n    """\n    Composes a container with a function returning ``Validated``.\n\n    .. code:: python\n\n      >>> from returns.pointfree import bind_validated\n      >>> from returns.validated import Invalid, Valid, Validated\n\n      >>> def bindable(arg: str) -> Validated[str, str]:\n      ...     if len(arg) > 1:\n      ...         return Valid(arg + \'b\')\n      ...     return Invalid((arg + \'c\',))\n\n      >>> bound = bind_validated(bindable)\n      >>> assert bound(Valid(\'aa\')) == Valid(\'aab\')\n      >>> assert bound(Valid(\'a\')) == Invalid((\'ac\',))\n      >>> assert bound(Invalid((\'a\',))) == Invalid((\'a\',))\n\n    """\n\n    @kinded\n    def factory(\n        container: KindN[_ValidatedLikeKind, _FirstType, _SecondType, _ThirdType],\n    ) -> KindN[_ValidatedLikeKind, _UpdatedType, _SecondType, _ThirdType]:\n        return container.bind_validated(function)\n\n    return factory\n```\n\n## 2. `returns/pointfree/__init__.py` — add one line (alphabetical, after `bind_result`)\n\n```python\nfrom returns.pointfree.bind_validated import bind_validated as bind_validated\n```\n\n## 3. `returns/converters.py` — add imports + four converters\n\nAdd to the import block (`returns/converters.py:1-8`):\n\n```python\nfrom returns.io import IO, IOResult\nfrom returns.validated import Invalid, Valid, Validated\n```\n\nAppend at end of file:\n\n```python\ndef validated_to_result(\n    container: Validated[_FirstType, _SecondType],\n) -> Result[_FirstType, tuple[_SecondType, ...]]:\n    """\n    Converts ``Validated`` to ``Result``.\n\n    ``Valid`` becomes ``Success``, ``Invalid`` becomes ``Failure``\n    with the whole accumulated tuple of errors preserved.\n\n    .. code:: python\n\n      >>> from returns.converters import validated_to_result\n      >>> from returns.result import Failure, Success\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert validated_to_result(Valid(1)) == Success(1)\n      >>> assert validated_to_result(Invalid((\'a\',))) == Failure((\'a\',))\n      >>> assert validated_to_result(Invalid((\'a\', \'b\'))) == Failure((\'a\', \'b\'))\n\n    """\n    if is_successful(container):\n        return Success(container.unwrap())\n    return Failure(container.failure())\n\n\ndef result_to_validated(\n    container: Result[_FirstType, _SecondType],\n) -> Validated[_FirstType, _SecondType]:\n    """\n    Converts ``Result`` to ``Validated``.\n\n    ``Success`` becomes ``Valid``, ``Failure`` becomes ``Invalid``\n    with a single error wrapped into a tuple.\n\n    .. code:: python\n\n      >>> from returns.converters import result_to_validated\n      >>> from returns.result import Failure, Success\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert result_to_validated(Success(1)) == Valid(1)\n      >>> assert result_to_validated(Failure(\'a\')) == Invalid((\'a\',))\n\n    """\n    return Validated.from_result(container)\n\n\ndef validated_to_maybe(\n    container: Validated[_FirstType, _SecondType],\n) -> Maybe[_FirstType]:\n    """\n    Converts ``Validated`` to ``Maybe``, dropping accumulated errors.\n\n    .. code:: python\n\n      >>> from returns.converters import validated_to_maybe\n      >>> from returns.maybe import Nothing, Some\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert validated_to_maybe(Valid(1)) == Some(1)\n      >>> assert validated_to_maybe(Invalid((\'a\',))) == Nothing\n\n    """\n    if is_successful(container):\n        return Some(container.unwrap())\n    return Nothing\n\n\ndef maybe_to_validated(\n    container: Maybe[_FirstType],\n    default_error: _SecondType,\n) -> Validated[_FirstType, _SecondType]:\n    """\n    Converts ``Maybe`` to ``Validated``.\n\n    ``Nothing`` becomes ``Invalid`` with ``default_error`` as a single error.\n\n    .. code:: python\n\n      >>> from returns.converters import maybe_to_validated\n      >>> from returns.maybe import Nothing, Some\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert maybe_to_validated(Some(1), \'error\') == Valid(1)\n      >>> assert maybe_to_validated(Nothing, \'error\') == Invalid((\'error\',))\n\n    """\n    if is_successful(container):\n        return Valid(container.unwrap())\n    return Invalid((default_error,))\n\n\ndef validated_to_io(\n    container: Validated[_FirstType, _SecondType],\n) -> IO[Validated[_FirstType, _SecondType]]:\n    """\n    Converts ``Validated`` to ``IO``, preserving ``Valid``/``Invalid``.\n\n    .. code:: python\n\n      >>> from returns.converters import validated_to_io\n      >>> from returns.io import IO\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert validated_to_io(Valid(1)) == IO(Valid(1))\n      >>> assert validated_to_io(Invalid((\'a\',))) == IO(Invalid((\'a\',)))\n\n    """\n    return IO(container)\n\n\ndef io_to_validated(\n    container: IO[Validated[_FirstType, _SecondType]],\n) -> Validated[_FirstType, _SecondType]:\n    """\n    Converts ``IO`` of ``Validated`` to plain ``Validated``.\n\n    .. code:: python\n\n      >>> from returns.converters import io_to_validated\n      >>> from returns.io import IO\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert io_to_validated(IO(Valid(1))) == Valid(1)\n      >>> assert io_to_validated(IO(Invalid((\'a\',)))) == Invalid((\'a\',))\n\n    """\n    return container.unwrap()\n\n\ndef validated_to_ioresult(\n    container: Validated[_FirstType, _SecondType],\n) -> IOResult[_FirstType, tuple[_SecondType, ...]]:\n    """\n    Converts ``Validated`` to ``IOResult``, keeping the error tuple.\n\n    .. code:: python\n\n      >>> from returns.converters import validated_to_ioresult\n      >>> from returns.io import IOFailure, IOSuccess\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert validated_to_ioresult(Valid(1)) == IOSuccess(1)\n      >>> assert validated_to_ioresult(\n      ...     Invalid((\'a\', \'b\')),\n      ... ) == IOFailure((\'a\', \'b\'))\n\n    """\n    return IOResult.from_result(validated_to_result(container))\n\n\ndef ioresult_to_validated(\n    container: IOResult[_FirstType, _SecondType],\n) -> Validated[_FirstType, _SecondType]:\n    """\n    Converts ``IOResult`` to ``Validated``, wrapping the error into a tuple.\n\n    .. code:: python\n\n      >>> from returns.converters import ioresult_to_validated\n      >>> from returns.io import IOFailure, IOSuccess\n      >>> from returns.validated import Invalid, Valid\n\n      >>> assert ioresult_to_validated(IOSuccess(1)) == Valid(1)\n      >>> assert ioresult_to_validated(IOFailure(\'a\')) == Invalid((\'a\',))\n\n    """\n    return Validated.from_result(container.unwrap())\n```\n\n`converters.py` has no `__all__` (verified: 110 lines, no `__all__`), so nothing else to update there. No circular import: `validated.py` imports only `returns.result`, and `converters.py` is a leaf module.\n\n## 4. Decorator\n\nAlready present and matching repo conventions (`returns/validated.py:577-663`, mirroring `returns.result.safe`): `@validated`, `@validated(exceptions=(...))`,