# VCS / tooling
.git
.github
.omo
.playwright-mcp
.vscode

# Local Python env — built fresh inside the image
.venv
**/__pycache__
*.pyc

# Secrets — never bake into the image
.env
client/.env

# Desktop client (Tauri 2 + Nuxt 4; separate build pipeline)
client/

# Runtime data — created at runtime, mount volumes here in production
src/
temp/
logs/output/
cron_jobs.json

# Runtime/user data — never baked into the image
workspace/
evals/results/
skills/plugins/

# Tests / documentation / generated code maps — never part of a release image
tests/
docs/
wiki/
graphify-out/
evals/
TODO/
# Root-level documentation; skills/**/SKILL.md stays (runtime data for the
# skill loader), and so do the skills' own README files.
README*.md
AGENTS.md
**/__tests__/
**/*.test.*
**/*.spec.*

# Model weights are downloaded at runtime into models/*/model_weight/
models/*/model_weight/

# Local docs / scratch
*.log
