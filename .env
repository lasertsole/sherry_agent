## 应用级非敏感配置（本文件入库跟踪；模型配置见 .models，联网配置见 .network）
## Non-secret application configuration. This file is tracked in git — never put
## an API key here. The model (LLM) configuration lives in .models and the
## network service configuration (web search / browser / tracing) in .network;
## both are gitignored, with .models.example / .network.example as templates.
##
## 模型配置（各模型厂商与开关）→ .models（模板 .models.example）
## 联网配置（Tavily / SearXNG / 浏览器代理 / LangSmith）→ .network（模板 .network.example）
## 修改后重启后端生效；前端可在「模型配置 / 模型联网」面板里编辑对应文件。

## Sandbox policy for terminal / python_repl / execute_code: required / auto / off
# required: the OS sandbox (bwrap on Linux, sandbox-exec on macOS) must be available,
#           otherwise the command is REJECTED (fail-closed) — the shipped default
# auto: use the sandbox when available, otherwise run UNSANDBOXED with a warning.
#       Those bare runs bypass the external-path HITL gate entirely, which is why
#       this is no longer the default; pick it only on a host where you accept that.
# off: disable sandboxing entirely (no probe, no wrap)
# The effective value (and whether a backend was found) is logged at boot, and
# GET /sandbox/status reports it. SANDBOX_STRICT_BOOT=1 additionally refuses to
# start when required is unmet.
# LOCAL OVERRIDE（本机无可用沙箱后端：bwrap 在该 PRoot 主机上不可用）——入库默认是 required。
# LOCAL OVERRIDE: no usable sandbox backend on this host (PRoot); the committed default is `required`.
SANDBOX_POLICY = auto
# Refuse to start when SANDBOX_POLICY=required and no backend is usable (default: warn only).
SANDBOX_STRICT_BOOT =

## Gateway auth (loopback API hardening)
# Token the gateway issues and accepts. Unset = a fresh random token per boot
# (the desktop client fetches it from GET /auth/token and echoes it in the
# `token` header / WS `?token=`). Set it to pin a value for scripts and CI.
SHERRY_GATEWAY_TOKEN =
# Origins allowed to call the API (comma-separated). Unset = the Tauri webview
# origins + the local Nuxt dev server. Any other browser Origin is refused.
SHERRY_ALLOWED_ORIGINS =
# Strict mode: refuse requests that carry no token (except GET /auth/token).
SHERRY_GATEWAY_REQUIRE_TOKEN = 0

## User login (menu → 账户 / Account)
# Seed for a FRESH database: true = login protection on from the first boot.
# Leave 0 and enable it from the account menu instead; the runtime switch lives
# in SQLite (src/data/auth.db), so the menu always wins after the first run.
SHERRY_AUTH_ENABLED = 0
# Require a login for non-loopback clients (the default). Set 0 to also require
# it on this machine (not recommended — it locks the desktop app out).
SHERRY_AUTH_REQUIRE_NON_LOOPBACK = 1
# Access-token lifetime (seconds; default 12h) and refresh-token lifetime (7d).
SHERRY_AUTH_SESSION_TTL = 43200
SHERRY_AUTH_REFRESH_TTL = 604800
# JWT signing key. Empty = a fresh random key per boot (every session dies with
# the process). Pin a long random value for a deployment you restart often.
SHERRY_AUTH_SECRET =

## Login brute-force throttle (password-only login: one account, no username).
# Consecutive failures a client may accumulate before the first lockout.
SHERRY_AUTH_LOGIN_MAX_ATTEMPTS = 5
# First lockout in seconds; each further failure doubles it.
SHERRY_AUTH_LOCKOUT_BASE_SECONDS = 5
# Ceiling of the escalating lockout.
SHERRY_AUTH_LOCKOUT_MAX_SECONDS = 900
# A failure streak older than this no longer counts (a typo is not a campaign).
SHERRY_AUTH_ATTEMPT_WINDOW_SECONDS = 900
# HTTPS-only session cookies (set 1 when the API is reached over TLS).
SHERRY_AUTH_COOKIE_SECURE = 0
