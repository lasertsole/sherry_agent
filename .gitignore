# Tools
.playwright-mcp
# AI tool configs — local dev-tools, kept out of the repo
opencode.json
# ZCode (this agent's own client): its ignore file and workspace state are
# per-machine dev-tool data, never project source.
.zcodeignore
.zcode/
# CodeGraph MCP index (@colbymchenry/codegraph) — regenerated, never commit
.codegraph/
# RAGAS eval artifacts (evals/evals.py) — per-run reports, never commit
evals/results/

# Env / deps
.venv
__pycache__
# .env is TRACKED: it holds the non-secret application configuration only
# (sandbox / gateway / login). The model and network credentials live in the
# gitignored .models / .network below — never put an API key in .env.
.models
.models.bak
.network
.network.bak
sherry.jsonc.bak
# models/
model_weight/
# Jina tokenizer files are downloaded next to the ONNX weights at runtime.
models/embed_model/code/tokenizer/

# Runtime data (src/, temp/, cron) — regenerated every run, never commit.
# /src/ is anchored to the repo root: an unanchored `src/` also swallowed
# client/src-tauri/src/, dropping the Tauri Rust sources from the repo.
/src/
# root temp/ — scratch/evidence dir, root only (cf. /workspace/ below)
/temp/
cron_jobs.json
skills/.curator_state
skills/.archive

# Logs
logs/output
logs/curator
logs/*.log

# RAG runtime artifacts — lightrag's default working_dir is ./rag_storage,
# which resolves relative to the cwd; ignore any stray occurrence.
**/rag_storage
*.db
*.db-shm
*.db-wal
# live persona workspace (root only); tests/workspace must stay trackable.
# The two agent-written notes under memory/ are RUNTIME state — the memory tool
# rewrites them mid-session — so they are deliberately untracked even though
# USER.md (authored) stays versioned; file_sync recreates them from the
# workspace/template copies on a fresh boot.
/workspace/
/workspace/memory/FACTS.md
/workspace/memory/MEMORY.md
skills/auto
skills/plugins/*.state.json
# Generated code-map wiki (root Obsidian vault; the ** form also covers
# per-project generated wikis) and the graphify code graph — regenerated, never
# committed. See packaging/check_release.py for the release-artifact guard.
/wiki/
**/wiki/
/graphify-out/
# Obsidian's per-vault config — created when the checkout or wiki/ is opened
# as a vault; machine-local state, never project source.
.obsidian/
skills/skills_snapshot.json
.omo/
static/
sessions/**/*.md
.idea/
.vscode/

# Code intelligence symbol index (subagent-only tree-sitter tooling)
.codeintel/

# Automated task/page snapshots (browser automation runtime state)
tasks-*.yml

# Vendored binary dependencies — never commit wheels
*.whl

# Model weight binaries — downloaded per machine, not source
*.bin
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt

# MinerU per-machine config — regenerated by ensure_mineru_models on every pipeline run
models/extract_model/mineru_config.json

client/repros/

# Coverage / perf artifacts — regenerated per run
.coverage
.coverage.*
htmlcov/

# Packaged desktop backend (PyInstaller onedir) + its work dir — built per OS,
# never committed (the tracked doc lives in packaging/README.md).
/client/src-tauri/sherry-backend/
/build/
