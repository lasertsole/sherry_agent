# Tools
.playwright-mcp
# OpenCode AI tool config — local dev-tool, kept out of the repo
opencode.json
# CodeGraph MCP index (@colbymchenry/codegraph) — regenerated, never commit
.codegraph/
# RAGAS eval artifacts (evals/evals.py) — per-run reports, never commit
evals/results/

# Env / deps
.venv
__pycache__
.env
.env.bak
# models/
model_weight/

# Runtime data (src/, temp/, cron) — regenerated every run, never commit
src/
# root temp/ — scratch/evidence dir, root only (cf. /workspace/ below)
/temp/
cron_jobs.json
skills/.curator_state
skills/.archive

# Logs
logs/output
logs/curator
logs/*.log

# RAG runtime artifacts — lightrag's default working_dir is ./rag_storage,
# which resolves relative to the cwd; ignore any stray occurrence.
**/rag_storage
*.db
*.db-shm
*.db-wal
# live persona workspace (root only); tests/workspace must stay trackable
/workspace/
skills/auto
skills/plugins/*.state.json
**/wiki/
skills/skills_snapshot.json
.omo/
static/
sessions/**/*.md
.idea/
.vscode/

# Code intelligence symbol index (subagent-only tree-sitter tooling)
.codeintel/

# Automated task/page snapshots (browser automation runtime state)
tasks-*.yml

# Vendored binary dependencies — never commit wheels
*.whl

# Model weight binaries — downloaded per machine, not source
*.bin
*.onnx
*.safetensors
*.pt
*.pth
*.ckpt

# MinerU per-machine config — regenerated by ensure_mineru_models on every pipeline run
models/extract_model/mineru_config.json

client/repros/
