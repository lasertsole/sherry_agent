{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_CHROMIUM_SANDBOX": "false",
        "PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH": "/opt/google/chrome/chrome"
      }
    }
  }
}